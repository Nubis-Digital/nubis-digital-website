@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@{
    Layout = "master.cshtml";
    var featureImage = Model.Value<IPublishedContent>("featuredImage");
    var publicationDate = Model.Value<DateTime?>("publicationDate");
    var tags = Model.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
    var mainContent = Model.Value<BlockGridModel>("mainContent");
    var postTitle = Model.Value<string>("postTitle");
}

<main class="relative min-h-screen bg-slate-50 text-slate-900 transition-colors duration-300 dark:bg-slate-950 dark:text-slate-100">
    <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-y-0 left-1/3 h-[140%] w-[120%] -translate-x-1/2 bg-[radial-gradient(circle_at_top,_rgba(56,189,248,0.18),_transparent_55%)]"></div>
        <div class="absolute inset-y-0 left-2/3 h-[120%] w-[90%] -translate-x-1/2 bg-[radial-gradient(circle_at_bottom,_rgba(129,140,248,0.14),_transparent_60%)]"></div>
    </div>

    <article class="relative mx-auto flex w-full max-w-5xl flex-col gap-12 px-6 py-24">
        <header class="glass-panel border border-white/10 bg-white/70 p-10 shadow-xl backdrop-blur-xl dark:bg-slate-900/60">
            <div class="flex flex-wrap items-center gap-4 text-sm font-medium uppercase tracking-wider text-slate-500 dark:text-slate-300">
                @if (publicationDate is DateTime date)
                {
                    <time datetime="@date:yyyy-MM-dd" class="rounded-full bg-slate-100 px-3 py-1 text-slate-700 dark:bg-slate-800/60 dark:text-slate-200">
                        @date.ToString("MMMM d, yyyy")
                    </time>
                }

                @foreach (var tag in tags)
                {
                    <span class="rounded-full bg-indigo-500/10 px-3 py-1 text-indigo-500 dark:bg-indigo-400/10 dark:text-indigo-300">@tag</span>
                }
            </div>

            <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl bg-gradient-to-r from-sky-400 to-indigo-500 bg-clip-text">
                @postTitle
            </h1>

            @if (!string.IsNullOrWhiteSpace(Model.Value<string>("subtitle")))
            {
                <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
                    @Model.Value("subtitle")
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Value<string>("author")))
            {
                <p class="mt-6 text-base font-medium text-slate-500 dark:text-slate-300">
                    Written by <span class="text-slate-800 dark:text-slate-200">@Model.Value("author")</span>
                </p>
            }
        </header>

        @if (featureImage is not null)
        {
            <figure class="overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
                <img src="@featureImage.Url()?width=1600" alt="@featureImage.Name" class="h-full w-full object-cover" />
            </figure>
        }

        <section class="prose prose-lg prose-slate mx-auto w-full dark:prose-invert">
            @if (mainContent?.Any() == true)
            {
                @await Html.PartialAsync("blockgrid/default", mainContent)
            }
            else
            {
                <div class="glass-panel border border-white/10 bg-white/60 p-8 text-slate-600 dark:bg-slate-900/60 dark:text-slate-300">
                    <p>
                        Start building this article by adding blocks to the <strong>Main Content</strong> area.
                    </p>
                </div>
            }
        </section>
    </article>
</main>
