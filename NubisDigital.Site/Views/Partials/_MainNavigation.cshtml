@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>
@using System
@using System.Collections.Generic
@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    var siteRoot = Model.AncestorOrSelf("siteRoot");
    var siteSettings = siteRoot?.FirstChild(x => x.ContentType.Alias == "siteSettings");
    var navLinks = siteSettings?.Value<IEnumerable<Link>>("navbarLinks") ?? Enumerable.Empty<Link>();
    var siteTitle = siteSettings?.Value<string>("siteTitle") ?? "Nubis Digital";
    
    // Get contact button link from settings
    var contactButtonLinks = siteSettings?.Value<IEnumerable<Link>>("contactButtonLink") ?? Enumerable.Empty<Link>();
    var contactButtonLink = contactButtonLinks.FirstOrDefault();
    var contactUrl = contactButtonLink?.Url ?? "#contact";
    var contactTarget = contactButtonLink?.Target ?? "_self";

    // Get current culture and available cultures
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var availableCultures = Model?.Cultures?.Keys?.ToList() ?? new List<string>();
}

<nav class="nav-enhanced sticky top-0 z-50 w-full border-b transition-all duration-300" aria-label="Primary site navigation" style="background: var(--nav-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-color: var(--glass-border);">
    <!-- Progress bar for scroll depth -->
    <div id="scroll-progress" class="absolute bottom-0 left-0 h-0.5 bg-gradient-to-r from-sky-400 to-indigo-500 transition-all duration-150" style="width: 0%;"></div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
            <a class="logo-link group flex items-center gap-3 text-slate-900 transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400 dark:text-white" href="@(siteRoot?.Url() ?? Url.Content("~/"))">
                @{
                    var logo = siteSettings?.Value<IPublishedContent>("siteLogo");
                }
                @if (logo != null)
                {
                    <img src="@logo.Url()" alt="@siteTitle" class="h-8 w-auto" />
                }
                else
                {
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-sky-400 to-indigo-500 text-sm font-black text-white shadow-lg shadow-sky-500/30 transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:shadow-sky-500/50">N</span>
                }
                <span class="flex flex-col leading-tight">
                    <span class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 transition-colors duration-300 group-hover:text-sky-500 dark:text-slate-400 dark:group-hover:text-sky-400">Nubis Digital</span>
                </span>
            </a>

            <div class="hidden flex-1 items-center justify-center md:flex">
                @if (navLinks.Any())
                {
                    <div class="nav-links-container relative">
                        <div class="nav-glass-tracker"></div>
                        <ul class="flex items-center gap-1 text-sm font-medium relative z-10">
                        @foreach (var link in navLinks)
                        {
                            var linkTarget = link.Target ?? "_self";
                            var isActive = (Model?.Url() == link.Url);
                            var linkClasses = "nav-link group relative inline-flex items-center justify-center px-4 py-2 transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400";
                            linkClasses += isActive
                                ? " text-sky-500 dark:text-sky-400"
                                : " text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white";

                            <li>
                                <a href="@link.Url" target="@linkTarget" class="@linkClasses" data-nav-link>
                                    <span class="relative z-10">@link.Name</span>
                                    @if (isActive)
                                    {
                                        <span class="absolute inset-x-2 -bottom-0.5 h-0.5 bg-gradient-to-r from-sky-400 to-indigo-500 rounded-full"></span>
                                    }
                                    else
                                    {
                                        <span class="absolute inset-x-2 -bottom-0.5 h-0.5 bg-gradient-to-r from-sky-400 to-indigo-500 rounded-full scale-x-0 transition-transform duration-300 group-hover:scale-x-100"></span>
                                    }
                                </a>
                            </li>
                        }
                        </ul>
                    </div>
                }
            </div>

            <div class="flex items-center gap-3">
                @* Language Switcher Dropdown *@
                @if (availableCultures.Count > 1)
                {
                    <div class="language-switcher hidden md:block relative">
                        <button id="language-dropdown-toggle"
                                type="button"
                                class="inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 text-slate-600 hover:bg-slate-100 hover:scale-105 dark:text-slate-300 dark:hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
                                aria-haspopup="true"
                                aria-expanded="false"
                                aria-label="Select language">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                            <svg class="h-4 w-4 transition-transform duration-200" id="language-dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="m6 9 6 6 6-6"/>
                            </svg>
                        </button>
                        
                        <div id="language-dropdown-menu"
                             class="absolute right-0 mt-2 w-48 origin-top-right rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 hidden"
                             style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border);"
                             role="menu"
                             aria-orientation="vertical"
                             aria-labelledby="language-dropdown-toggle">
                            <div class="py-1" role="none">
                                @foreach (var culture in availableCultures)
                                {
                                    var isActive = culture.Equals(currentCulture, StringComparison.OrdinalIgnoreCase);
                                    var cultureUrl = Model?.Url(culture) ?? "#";
                                    var displayName = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "English" :
                                                    culture.StartsWith("es", StringComparison.OrdinalIgnoreCase) ? "Español" :
                                                    culture;
                                    var flag = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "🇺🇸" :
                                              culture.StartsWith("es", StringComparison.OrdinalIgnoreCase) ? "🇪🇸" :
                                              "🌐";
                                    var linkClasses = "flex items-center gap-3 px-4 py-2 text-sm transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400";
                                    linkClasses += isActive
                                        ? " bg-gradient-to-r from-sky-500/10 to-indigo-500/10 text-sky-600 dark:text-sky-400 font-medium"
                                        : " text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800";
                                    
                                    <a href="@cultureUrl"
                                       class="@linkClasses"
                                       hreflang="@culture"
                                       role="menuitem"
                                       aria-label="Switch to @displayName"
                                       aria-current="@(isActive ? "true" : "false")">
                                        <span class="text-lg">@flag</span>
                                        <span>@displayName</span>
                                        @if (isActive)
                                        {
                                            <svg class="ml-auto h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M20 6 9 17l-5-5"/>
                                            </svg>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* Theme Switcher Dropdown *@
                <div class="theme-switcher relative">
                    <button id="theme-dropdown-toggle"
                            type="button"
                            class="inline-flex items-center gap-2 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300 text-slate-600 hover:bg-slate-100 hover:scale-105 dark:text-slate-300 dark:hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-label="Select theme">
                        <svg id="theme-icon-sun" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4"/>
                            <path d="M12 2v2"/>
                            <path d="M12 20v2"/>
                            <path d="m4.93 4.93 1.41 1.41"/>
                            <path d="m17.66 17.66 1.41 1.41"/>
                            <path d="M2 12h2"/>
                            <path d="M20 12h2"/>
                            <path d="m6.34 17.66-1.41 1.41"/>
                            <path d="m19.07 4.93-1.41 1.41"/>
                        </svg>
                        <svg id="theme-icon-moon" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                        </svg>
                        <svg class="h-4 w-4 transition-transform duration-200" id="theme-dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m6 9 6 6 6-6"/>
                        </svg>
                    </button>
                    
                    <div id="theme-dropdown-menu"
                         class="absolute right-0 mt-2 w-48 origin-top-right rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 hidden"
                         style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border);"
                         role="menu"
                         aria-orientation="vertical"
                         aria-labelledby="theme-dropdown-toggle">
                        <div class="py-1" role="none">
                            <button type="button"
                                    data-theme-option="light"
                                    class="flex items-center gap-3 px-4 py-2 text-sm w-full text-left transition-colors duration-200 text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
                                    role="menuitem">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="4"/>
                                    <path d="M12 2v2"/>
                                    <path d="M12 20v2"/>
                                    <path d="m4.93 4.93 1.41 1.41"/>
                                    <path d="m17.66 17.66 1.41 1.41"/>
                                    <path d="M2 12h2"/>
                                    <path d="M20 12h2"/>
                                    <path d="m6.34 17.66-1.41 1.41"/>
                                    <path d="m19.07 4.93-1.41 1.41"/>
                                </svg>
                                <span class="flex-1">Light</span>
                                <svg class="h-4 w-4 hidden theme-check-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                            </button>
                            
                            <button type="button"
                                    data-theme-option="dark"
                                    class="flex items-center gap-3 px-4 py-2 text-sm w-full text-left transition-colors duration-200 text-slate-700 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
                                    role="menuitem">
                                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                                </svg>
                                <span class="flex-1">Dark</span>
                                <svg class="h-4 w-4 hidden theme-check-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                @* Contact Button *@
                <a href="@contactUrl"
                   target="@contactTarget"
                   class="hidden md:inline-flex items-center px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-gradient-to-r from-sky-500 to-indigo-500 hover:from-sky-600 hover:to-indigo-600 shadow-lg shadow-sky-500/30 hover:shadow-xl hover:shadow-sky-500/50 transition-all duration-300 hover:scale-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
                   aria-label="Contact us">
                    Contact
                </a>

                <button id="main-nav-toggle" type="button" class="hamburger-menu inline-flex h-10 w-10 items-center justify-center rounded-lg text-slate-600 transition-all duration-300 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white md:hidden" aria-controls="main-nav-panel" aria-expanded="false">
                    <span class="sr-only">Open main navigation menu</span>
                    <div class="hamburger-icon">
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                        <span class="hamburger-line"></span>
                    </div>
                </button>
            </div>
        </div>

        @if (navLinks.Any())
        {
            <div id="main-nav-panel" class="hidden border-t py-4 text-base font-medium md:hidden" style="border-color: var(--glass-border);">
                <ul class="flex flex-col">
                    @foreach (var link in navLinks)
                    {
                        var linkTarget = link.Target ?? "_self";
                        var isActive = (Model?.Url() == link.Url);
                        var linkClasses = "flex items-center justify-between px-4 py-3 transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400";
                        linkClasses += isActive
                            ? " text-sky-500 dark:text-sky-400"
                            : " text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white";

                        <li>
                            <a href="@link.Url" target="@linkTarget" class="@linkClasses" data-nav-link>
                                <span>@link.Name</span>
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </a>
                        </li>
                    }
                    
                    @* Mobile Contact Button *@
                    <li class="border-t mt-2 pt-2" style="border-color: var(--glass-border);">
                        <a href="@contactUrl"
                           target="@contactTarget"
                           class="flex items-center justify-center px-4 py-3 rounded-lg text-white bg-gradient-to-r from-sky-500 to-indigo-500 hover:from-sky-600 hover:to-indigo-600 shadow-lg shadow-sky-500/30 transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400 font-semibold"
                           aria-label="Contact us">
                            Contact
                        </a>
                    </li>
                    
                    @* Mobile Language Switcher *@
                    @if (availableCultures.Count > 1)
                    {
                        <li class="border-t mt-2 pt-2" style="border-color: var(--glass-border);">
                            <div class="px-4 py-2">
                                <button id="mobile-language-toggle"
                                        type="button"
                                        class="flex items-center justify-between w-full px-4 py-3 rounded-md text-sm font-medium transition-all duration-200 bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
                                        aria-expanded="false"
                                        aria-controls="mobile-language-menu">
                                    <span class="flex items-center gap-2">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10"/>
                                            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                            <path d="M2 12h20"/>
                                        </svg>
                                        <span>
                                            @{
                                                var currentDisplayName = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "English" :
                                                                        currentCulture.StartsWith("es", StringComparison.OrdinalIgnoreCase) ? "Español" :
                                                                        currentCulture;
                                            }
                                            @currentDisplayName
                                        </span>
                                    </span>
                                    <svg class="h-4 w-4 transition-transform duration-200" id="mobile-language-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m6 9 6 6 6-6"/>
                                    </svg>
                                </button>
                                
                                <div id="mobile-language-menu" class="hidden mt-2 flex flex-col gap-2">
                                    @foreach (var culture in availableCultures)
                                    {
                                        var isActive = culture.Equals(currentCulture, StringComparison.OrdinalIgnoreCase);
                                        var cultureUrl = Model?.Url(culture) ?? "#";
                                        var displayName = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "English" :
                                                        culture.StartsWith("es", StringComparison.OrdinalIgnoreCase) ? "Español" :
                                                        culture;
                                        var flag = culture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "🇺🇸" :
                                                   culture.StartsWith("es", StringComparison.OrdinalIgnoreCase) ? "🇪🇸" :
                                                   "🌐";
                                        var linkClasses = "flex items-center gap-3 px-4 py-3 rounded-md text-sm font-medium transition-all duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400";
                                        linkClasses += isActive
                                            ? " bg-gradient-to-r from-sky-500 to-indigo-500 text-white shadow-lg shadow-sky-500/30"
                                            : " bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700";
                                        
                                        <a href="@cultureUrl"
                                           class="@linkClasses"
                                           hreflang="@culture"
                                           aria-label="Switch to @displayName"
                                           aria-current="@(isActive ? "true" : "false")">
                                            <span class="text-lg">@flag</span>
                                            <span class="flex-1">@displayName</span>
                                            @if (isActive)
                                            {
                                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M20 6 9 17l-5-5"/>
                                                </svg>
                                            }
                                        </a>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</nav>

<style>
    /* Enhanced Navigation Styles */
    .nav-enhanced {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    
    .nav-enhanced.scrolled {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
    
    /* Animated Hamburger Menu */
    .hamburger-icon {
        width: 20px;
        height: 16px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    
    .hamburger-line {
        width: 100%;
        height: 2px;
        background-color: currentColor;
        border-radius: 2px;
        transition: all 0.3s ease;
    }
    
    .hamburger-menu[aria-expanded="true"] .hamburger-line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
    }
    
    .hamburger-menu[aria-expanded="true"] .hamburger-line:nth-child(2) {
        opacity: 0;
        transform: translateX(-10px);
    }
    
    .hamburger-menu[aria-expanded="true"] .hamburger-line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
    }
    
    /* Scroll Progress Bar Animation */
    #scroll-progress {
        background: linear-gradient(90deg,
            var(--logo-color-1) 0%,
            var(--logo-color-2) 100%);
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.5);
    }
    
    /* Navigation Links Container */
    .nav-links-container {
        --tracker-x: 0px;
        --tracker-y: 0px;
        --tracker-width: 0px;
        --tracker-opacity: 0;
    }
    
    /* Shared Glass Tracker - follows mouse across all nav links */
    .nav-glass-tracker {
        position: absolute;
        left: var(--tracker-x);
        top: var(--tracker-y);
        width: var(--tracker-width);
        height: 100%;
        opacity: var(--tracker-opacity);
        pointer-events: none;
        z-index: 0;
        transition:
            left 0.3s cubic-bezier(0.4, 0, 0.2, 1),
            width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: left, width, opacity;
    }
    
    /* Morphing liquid blob background */
    .nav-glass-tracker::before {
        content: '';
        position: absolute;
        inset: -8px;
        background:
            radial-gradient(
                ellipse 120% 80% at 50% 50%,
                rgba(236, 72, 153, 0.4) 0%,
                rgba(168, 85, 247, 0.35) 20%,
                rgba(99, 102, 241, 0.3) 35%,
                rgba(59, 130, 246, 0.25) 50%,
                rgba(56, 189, 248, 0.2) 65%,
                transparent 80%
            );
        border-radius: 50% 40% 60% 50% / 60% 50% 50% 40%;
        filter: blur(20px) saturate(1.5);
        animation: liquidMorph 3s ease-in-out infinite;
        mix-blend-mode: screen;
    }
    
    /* Glass overlay */
    .nav-glass-tracker::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                circle at 50% 50%,
                rgba(255, 255, 255, 0.25) 0%,
                rgba(168, 85, 247, 0.15) 30%,
                rgba(56, 189, 248, 0.12) 60%,
                transparent 100%
            );
        border-radius: 12px;
        backdrop-filter: blur(12px) saturate(1.8);
        -webkit-backdrop-filter: blur(12px) saturate(1.8);
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow:
            inset 0 1px 2px rgba(255, 255, 255, 0.4),
            inset 0 -1px 2px rgba(168, 85, 247, 0.2);
    }
    
    /* Dark mode tracker */
    .dark .nav-glass-tracker::before {
        background:
            radial-gradient(
                ellipse 120% 80% at 50% 50%,
                rgba(236, 72, 153, 0.5) 0%,
                rgba(168, 85, 247, 0.45) 20%,
                rgba(99, 102, 241, 0.4) 35%,
                rgba(59, 130, 246, 0.35) 50%,
                rgba(56, 189, 248, 0.3) 65%,
                transparent 80%
            );
        filter: blur(20px) saturate(2);
    }
    
    .dark .nav-glass-tracker::after {
        background:
            radial-gradient(
                circle at 50% 50%,
                rgba(168, 85, 247, 0.25) 0%,
                rgba(99, 102, 241, 0.2) 30%,
                rgba(56, 189, 248, 0.18) 60%,
                transparent 100%
            );
        border: 1px solid rgba(168, 85, 247, 0.4);
        box-shadow:
            inset 0 1px 2px rgba(168, 85, 247, 0.5),
            inset 0 -1px 2px rgba(56, 189, 248, 0.3),
            0 4px 20px rgba(168, 85, 247, 0.3),
            0 2px 8px rgba(56, 189, 248, 0.2);
    }
    
    /* Apple-style Liquid Morphing Blob Effect */
    .nav-link {
        overflow: visible;
        position: relative;
        --mouse-x: 50%;
        --mouse-y: 50%;
    }
    
    /* Subtle per-link glow effect (works with shared tracker) */
    .nav-link::before {
        content: '';
        position: absolute;
        inset: -4px;
        background:
            radial-gradient(
                ellipse 100% 60% at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(168, 85, 247, 0.15) 0%,
                rgba(99, 102, 241, 0.12) 30%,
                rgba(56, 189, 248, 0.1) 50%,
                transparent 70%
            );
        opacity: 0;
        transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        filter: blur(8px);
        pointer-events: none;
        mix-blend-mode: screen;
    }
    
    .nav-link:hover::before {
        opacity: 1;
    }
    
    @@keyframes liquidMorph {
        0%, 100% {
            border-radius: 50% 40% 60% 50% / 60% 50% 50% 40%;
            filter: blur(20px) saturate(1.5);
            transform: scale(1) rotate(0deg);
        }
        25% {
            border-radius: 40% 60% 50% 40% / 50% 60% 40% 60%;
            filter: blur(22px) saturate(1.7);
            transform: scale(1.05) rotate(2deg);
        }
        50% {
            border-radius: 60% 50% 40% 60% / 40% 50% 60% 50%;
            filter: blur(24px) saturate(1.8);
            transform: scale(1.08) rotate(-2deg);
        }
        75% {
            border-radius: 50% 60% 40% 50% / 60% 40% 50% 60%;
            filter: blur(22px) saturate(1.6);
            transform: scale(1.05) rotate(1deg);
        }
    }
    
    /* Dark mode - more vibrant per-link glow */
    .dark .nav-link::before {
        background:
            radial-gradient(
                ellipse 100% 60% at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(168, 85, 247, 0.25) 0%,
                rgba(99, 102, 241, 0.2) 30%,
                rgba(56, 189, 248, 0.15) 50%,
                transparent 70%
            );
        filter: blur(10px);
    }
    
    /* Logo Animation */
    .logo-link:hover {
        transform: translateY(-1px);
    }
    
    /* Dropdown Menu Animations */
    #language-dropdown-menu,
    #theme-dropdown-menu {
        animation: slideDown 0.2s ease-out;
        transform-origin: top;
    }
    
    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    
    /* Mobile Menu Slide Animation */
    #main-nav-panel {
        animation: slideIn 0.3s ease-out;
    }
    
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    (() => {
        if (window.__nubisNavigationInitialized) {
            return;
        }

        window.__nubisNavigationInitialized = true;
        
        // --- SHARED GLASS TRACKER EFFECT ---
        const navLinksContainer = document.querySelector('.nav-links-container');
        const navLinks = document.querySelectorAll('.nav-link');
        
        if (navLinksContainer && navLinks.length > 0) {
            const lerp = (start, end, factor) => start + (end - start) * factor;
            
            let currentHoveredLink = null;
            let targetX = 0;
            let targetWidth = 0;
            let targetOpacity = 0;
            let currentX = 0;
            let currentWidth = 0;
            let currentOpacity = 0;
            let animationFrameId = null;
            
            const updateTracker = () => {
                // Smooth interpolation
                currentX = lerp(currentX, targetX, 0.2);
                currentWidth = lerp(currentWidth, targetWidth, 0.2);
                currentOpacity = lerp(currentOpacity, targetOpacity, 0.15);
                
                navLinksContainer.style.setProperty('--tracker-x', `${currentX}px`);
                navLinksContainer.style.setProperty('--tracker-width', `${currentWidth}px`);
                navLinksContainer.style.setProperty('--tracker-opacity', currentOpacity);
                
                // Continue animation if not at target
                if (Math.abs(currentX - targetX) > 0.5 ||
                    Math.abs(currentWidth - targetWidth) > 0.5 ||
                    Math.abs(currentOpacity - targetOpacity) > 0.01) {
                    animationFrameId = requestAnimationFrame(updateTracker);
                } else {
                    animationFrameId = null;
                }
            };
            
            navLinks.forEach(link => {
                link.addEventListener('mouseenter', () => {
                    currentHoveredLink = link;
                    const containerRect = navLinksContainer.getBoundingClientRect();
                    const linkRect = link.getBoundingClientRect();
                    
                    targetX = linkRect.left - containerRect.left;
                    targetWidth = linkRect.width;
                    targetOpacity = 1;
                    
                    if (!animationFrameId) {
                        updateTracker();
                    }
                });
                
                link.addEventListener('mouseleave', () => {
                    if (currentHoveredLink === link) {
                        currentHoveredLink = null;
                        targetOpacity = 0;
                        
                        if (!animationFrameId) {
                            updateTracker();
                        }
                    }
                });
            });
            
            // Also keep per-link mouse tracking for the individual ::before/::after effects
            navLinks.forEach(link => {
                let targetMouseX = 50;
                let targetMouseY = 50;
                let currentMouseX = 50;
                let currentMouseY = 50;
                let mouseAnimationFrameId = null;
                let isHovering = false;
                
                const updateMousePosition = () => {
                    currentMouseX = lerp(currentMouseX, targetMouseX, 0.15);
                    currentMouseY = lerp(currentMouseY, targetMouseY, 0.15);
                    
                    link.style.setProperty('--mouse-x', `${currentMouseX}%`);
                    link.style.setProperty('--mouse-y', `${currentMouseY}%`);
                    
                    if (Math.abs(currentMouseX - targetMouseX) > 0.1 ||
                        Math.abs(currentMouseY - targetMouseY) > 0.1) {
                        mouseAnimationFrameId = requestAnimationFrame(updateMousePosition);
                    } else {
                        mouseAnimationFrameId = null;
                    }
                };
                
                link.addEventListener('mouseenter', () => {
                    isHovering = true;
                });
                
                link.addEventListener('mousemove', (e) => {
                    if (isHovering) {
                        const rect = link.getBoundingClientRect();
                        targetMouseX = ((e.clientX - rect.left) / rect.width) * 100;
                        targetMouseY = ((e.clientY - rect.top) / rect.height) * 100;
                        
                        if (!mouseAnimationFrameId) {
                            updateMousePosition();
                        }
                    }
                });
                
                link.addEventListener('mouseleave', () => {
                    isHovering = false;
                    targetMouseX = 50;
                    targetMouseY = 50;
                    
                    if (!mouseAnimationFrameId) {
                        updateMousePosition();
                    }
                });
            });
        }
        
        // --- SCROLL PROGRESS BAR ---
        const scrollProgress = document.getElementById('scroll-progress');
        const nav = document.querySelector('.nav-enhanced');
        
        function updateScrollProgress() {
            const windowHeight = window.innerHeight;
            const documentHeight = document.documentElement.scrollHeight;
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            const scrollPercent = (scrollTop / (documentHeight - windowHeight)) * 100;
            
            if (scrollProgress) {
                scrollProgress.style.width = `${Math.min(scrollPercent, 100)}%`;
            }
            
            // Add shadow on scroll
            if (nav) {
                if (scrollTop > 10) {
                    nav.classList.add('scrolled');
                } else {
                    nav.classList.remove('scrolled');
                }
            }
        }
        
        window.addEventListener('scroll', updateScrollProgress, { passive: true });
        updateScrollProgress(); // Initial call

        const navToggle = document.getElementById('main-nav-toggle');
        const navPanel = document.getElementById('main-nav-panel');
        
        // Theme dropdown elements
        const themeDropdownToggle = document.getElementById('theme-dropdown-toggle');
        const themeDropdownMenu = document.getElementById('theme-dropdown-menu');
        const themeDropdownIcon = document.getElementById('theme-dropdown-icon');
        const themeIconSun = document.getElementById('theme-icon-sun');
        const themeIconMoon = document.getElementById('theme-icon-moon');
        const themeCurrentLabel = document.getElementById('theme-current-label');
        const themeCheckLight = document.querySelector('.theme-check-light');
        const themeCheckDark = document.querySelector('.theme-check-dark');

        // Update theme UI based on current theme
        const updateThemeUI = (theme) => {
            if (theme === 'light') {
                themeIconSun?.classList.remove('hidden');
                themeIconMoon?.classList.add('hidden');
                themeCheckLight?.classList.remove('hidden');
                themeCheckDark?.classList.add('hidden');
            } else {
                themeIconSun?.classList.add('hidden');
                themeIconMoon?.classList.remove('hidden');
                themeCheckLight?.classList.add('hidden');
                themeCheckDark?.classList.remove('hidden');
            }
        };

        // Set theme dropdown state (open/closed)
        const setThemeDropdownState = (open) => {
            themeDropdownToggle?.setAttribute('aria-expanded', open.toString());
            themeDropdownMenu?.classList.toggle('hidden', !open);
            if (themeDropdownIcon) {
                themeDropdownIcon.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        };

        // Initialize theme UI on page load
        const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
        updateThemeUI(currentTheme);

        // Toggle theme dropdown
        themeDropdownToggle?.addEventListener('click', () => {
            const isExpanded = themeDropdownToggle.getAttribute('aria-expanded') === 'true';
            setThemeDropdownState(!isExpanded);
        });

        // Theme selection from dropdown
        document.querySelectorAll('[data-theme-option]').forEach(button => {
            button.addEventListener('click', () => {
                const selectedTheme = button.getAttribute('data-theme-option');
                
                // Use the global theme toggle function if it exists
                if (typeof window.toggleTheme === 'function') {
                    const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
                    // Only toggle if we're switching to a different theme
                    if (currentTheme !== selectedTheme) {
                        window.toggleTheme();
                    }
                }
                
                updateThemeUI(selectedTheme);
                setThemeDropdownState(false);
            });
        });

        // Close theme dropdown when clicking outside
        document.addEventListener('click', (event) => {
            if (!themeDropdownToggle?.contains(event.target) && !themeDropdownMenu?.contains(event.target)) {
                setThemeDropdownState(false);
            }
        });

        // Language dropdown functionality
        const languageDropdownToggle = document.getElementById('language-dropdown-toggle');
        const languageDropdownMenu = document.getElementById('language-dropdown-menu');
        const languageDropdownIcon = document.getElementById('language-dropdown-icon');

        const setLanguageDropdownState = (open) => {
            languageDropdownToggle?.setAttribute('aria-expanded', open.toString());
            if (languageDropdownMenu) {
                languageDropdownMenu.classList.toggle('hidden', !open);
            }
            if (languageDropdownIcon) {
                languageDropdownIcon.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        };

        languageDropdownToggle?.addEventListener('click', () => {
            const isExpanded = languageDropdownToggle.getAttribute('aria-expanded') === 'true';
            setLanguageDropdownState(!isExpanded);
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (event) => {
            if (!languageDropdownToggle?.contains(event.target) && !languageDropdownMenu?.contains(event.target)) {
                setLanguageDropdownState(false);
            }
        });

        // Close dropdown on Escape key
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setLanguageDropdownState(false);
                setMobileLanguageDropdownState(false);
            }
        });

        // Mobile language dropdown functionality
        const mobileLanguageToggle = document.getElementById('mobile-language-toggle');
        const mobileLanguageMenu = document.getElementById('mobile-language-menu');
        const mobileLanguageIcon = document.getElementById('mobile-language-icon');

        const setMobileLanguageDropdownState = (open) => {
            mobileLanguageToggle?.setAttribute('aria-expanded', open.toString());
            if (mobileLanguageMenu) {
                mobileLanguageMenu.classList.toggle('hidden', !open);
            }
            if (mobileLanguageIcon) {
                mobileLanguageIcon.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        };

        mobileLanguageToggle?.addEventListener('click', () => {
            const isExpanded = mobileLanguageToggle.getAttribute('aria-expanded') === 'true';
            setMobileLanguageDropdownState(!isExpanded);
        });

        const setMenuState = (open) => {
            navToggle?.setAttribute('aria-expanded', open.toString());
            if (navPanel) {
                navPanel.classList.toggle('hidden', !open);
            }
            document.body.classList.toggle('overflow-hidden', open);
        };

        navToggle?.addEventListener('click', () => {
            const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
            setMenuState(!isExpanded);
        });

        if (navPanel) {
            navPanel.querySelectorAll('[data-nav-link]').forEach((link) => {
                link.addEventListener('click', () => setMenuState(false));
            });
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setMenuState(false);
            }
        });

        if (window.matchMedia) {
            window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
                if (event.matches) {
                    setMenuState(false);
                }
            });
        }
    })();
</script>