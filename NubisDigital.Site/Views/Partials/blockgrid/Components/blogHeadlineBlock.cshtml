@using Umbraco.Cms.Core.Models.Blocks
@using System.Text.RegularExpressions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var headlineText = Model.Content.Value<string>("headingText");
    var headingLevel = Model.Content.Value<string>("headingLevel") ?? "h2";
    
    // Create URL-friendly anchor ID
    var anchorId = Regex.Replace(headlineText?.ToLower() ?? "", @"[^a-z0-9\s-]", "");
    anchorId = Regex.Replace(anchorId, @"\s+", "-").Trim('-');
    anchorId = string.IsNullOrEmpty(anchorId) ? Guid.NewGuid().ToString("N").Substring(0, 8) : anchorId;
}

@if (!string.IsNullOrEmpty(headlineText))
{
    <div class="headline-block-container my-8">
        @switch (headingLevel)
        {
            case "h1":
                <h1 id="@anchorId" class="group relative scroll-mt-24 text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 dark:text-white mb-6 transition-all duration-300 hover:text-sky-600 dark:hover:text-sky-400" style="letter-spacing: -0.03em;">
                    <a href="#@anchorId" class="anchor-link no-underline" aria-label="Link to this section">
                        <span class="bg-gradient-to-r from-sky-500 to-indigo-500 bg-clip-text text-transparent">@headlineText</span>
                    </a>
                    <button onclick="copyHeadlineLink('@anchorId')" class="ml-3 p-2 rounded-lg bg-slate-200/0 hover:bg-slate-200/80 dark:bg-slate-700/0 dark:hover:bg-slate-700/80 text-slate-400 hover:text-sky-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 align-middle" aria-label="Copy link to this section" title="Copy link">
                        <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                        </svg>
                    </button>
                    <span class="absolute -left-6 top-0 text-sky-500/20 dark:text-sky-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 select-none">#</span>
                </h1>
                break;
            case "h2":
                <h2 id="@anchorId" class="group relative scroll-mt-24 text-3xl md:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-5 transition-all duration-300 hover:text-sky-600 dark:hover:text-sky-400" style="letter-spacing: -0.02em;">
                    <a href="#@anchorId" class="anchor-link no-underline" aria-label="Link to this section">@headlineText</a>
                    <button onclick="copyHeadlineLink('@anchorId')" class="ml-3 p-2 rounded-lg bg-slate-200/0 hover:bg-slate-200/80 dark:bg-slate-700/0 dark:hover:bg-slate-700/80 text-slate-400 hover:text-sky-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 align-middle" aria-label="Copy link" title="Copy link">
                        <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                        </svg>
                    </button>
                    <span class="absolute -left-6 top-0 text-sky-500/20 dark:text-sky-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 select-none">##</span>
                </h2>
                break;
            case "h3":
                <h3 id="@anchorId" class="group relative scroll-mt-24 text-2xl md:text-3xl lg:text-4xl font-bold text-slate-900 dark:text-white mb-4 transition-all duration-300 hover:text-sky-600 dark:hover:text-sky-400" style="letter-spacing: -0.01em;">
                    <a href="#@anchorId" class="anchor-link no-underline" aria-label="Link to this section">@headlineText</a>
                    <button onclick="copyHeadlineLink('@anchorId')" class="ml-2 p-1.5 rounded-lg bg-slate-200/0 hover:bg-slate-200/80 dark:bg-slate-700/0 dark:hover:bg-slate-700/80 text-slate-400 hover:text-sky-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 align-middle" aria-label="Copy link" title="Copy link">
                        <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                        </svg>
                    </button>
                    <span class="absolute -left-6 top-0 text-sky-500/20 dark:text-sky-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 select-none">###</span>
                </h3>
                break;
            case "h4":
                <h4 id="@anchorId" class="group relative scroll-mt-24 text-xl md:text-2xl lg:text-3xl font-bold text-slate-900 dark:text-white mb-3 transition-all duration-300 hover:text-sky-600 dark:hover:text-sky-400">
                    <a href="#@anchorId" class="anchor-link no-underline" aria-label="Link to this section">@headlineText</a>
                    <button onclick="copyHeadlineLink('@anchorId')" class="ml-2 p-1.5 rounded-lg bg-slate-200/0 hover:bg-slate-200/80 dark:bg-slate-700/0 dark:hover:bg-slate-700/80 text-slate-400 hover:text-sky-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 align-middle" aria-label="Copy link" title="Copy link">
                        <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                        </svg>
                    </button>
                    <span class="absolute -left-6 top-0 text-sky-500/20 dark:text-sky-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 select-none">####</span>
                </h4>
                break;
            case "h5":
                <h5 id="@anchorId" class="group relative scroll-mt-24 text-lg md:text-xl lg:text-2xl font-bold text-slate-900 dark:text-white mb-3 transition-all duration-300 hover:text-sky-600 dark:hover:text-sky-400">
                    <a href="#@anchorId" class="anchor-link no-underline" aria-label="Link to this section">@headlineText</a>
                    <button onclick="copyHeadlineLink('@anchorId')" class="ml-2 p-1 rounded-lg bg-slate-200/0 hover:bg-slate-200/80 dark:bg-slate-700/0 dark:hover:bg-slate-700/80 text-slate-400 hover:text-sky-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 align-middle" aria-label="Copy link" title="Copy link">
                        <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                        </svg>
                    </button>
                    <span class="absolute -left-6 top-0 text-sky-500/20 dark:text-sky-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 select-none">#####</span>
                </h5>
                break;
            case "h6":
                <h6 id="@anchorId" class="group relative scroll-mt-24 text-base md:text-lg lg:text-xl font-bold text-slate-900 dark:text-white mb-2 transition-all duration-300 hover:text-sky-600 dark:hover:text-sky-400">
                    <a href="#@anchorId" class="anchor-link no-underline" aria-label="Link to this section">@headlineText</a>
                    <button onclick="copyHeadlineLink('@anchorId')" class="ml-2 p-1 rounded-lg bg-slate-200/0 hover:bg-slate-200/80 dark:bg-slate-700/0 dark:hover:bg-slate-700/80 text-slate-400 hover:text-sky-600 dark:hover:text-indigo-400 opacity-0 group-hover:opacity-100 transition-all duration-300 align-middle" aria-label="Copy link" title="Copy link">
                        <svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                        </svg>
                    </button>
                    <span class="absolute -left-6 top-0 text-sky-500/20 dark:text-sky-400/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 select-none">######</span>
                </h6>
                break;
        }
    </div>
}

<script>
    // Copy headline link to clipboard - only define once
    if (typeof window.copyHeadlineLink === 'undefined') {
        window.copyHeadlineLink = function(anchorId) {
            const url = window.location.origin + window.location.pathname + '#' + anchorId;
            navigator.clipboard.writeText(url).then(() => {
                showHeadlineNotification('Link copied to clipboard!');
            }).catch(err => {
                console.error('Failed to copy link:', err);
                showHeadlineNotification('Failed to copy link');
            });
        };
        
        window.showHeadlineNotification = function(message) {
            const notification = document.createElement('div');
            notification.className = 'fixed bottom-6 right-6 px-6 py-3 rounded-lg shadow-2xl z-50 bg-sky-500 text-white transition-all duration-300';
            notification.textContent = message;
            
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.opacity = '0';
                notification.style.transform = 'translateY(20px)';
                setTimeout(() => notification.remove(), 300);
            }, 2500);
        };
        
        // Smooth scroll to anchor with offset - set up once
        setTimeout(() => {
            document.querySelectorAll('a.anchor-link').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);
                    
                    if (targetElement) {
                        const offset = 100; // Offset for fixed header
                        const elementPosition = targetElement.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.pageYOffset - offset;
                        
                        window.scrollTo({
                            top: offsetPosition,
                            behavior: 'smooth'
                        });
                        
                        // Update URL without triggering scroll
                        history.pushState(null, null, '#' + targetId);
                    }
                });
            });
        }, 100);
    }
</script>

<style>
    .anchor-link {
        color: inherit;
        text-decoration: none;
    }
    
    .anchor-link:hover {
        color: inherit;
    }
    
    /* Smooth scroll behavior */
    html {
        scroll-behavior: smooth;
    }
    
    @@media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
    }
</style>