@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var headlineText = Model.Content.Value<string>("headlineText");
    var headingLevel = Model.Content.Value<string>("headingLevel") ?? "h2";
}

@if (!string.IsNullOrEmpty(headlineText))
{
    @switch (headingLevel)
    {
        case "h1":
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">@headlineText</h1>
            break;
        case "h2":
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-5">@headlineText</h2>
            break;
        case "h3":
            <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">@headlineText</h3>
            break;
        case "h4":
            <h4 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-3">@headlineText</h4>
            break;
        case "h5":
            <h5 class="text-lg md:text-xl font-bold text-gray-900 dark:text-white mb-3">@headlineText</h5>
            break;
        case "h6":
            <h6 class="text-base md:text-lg font-bold text-gray-900 dark:text-white mb-2">@headlineText</h6>
            break;
    }
}