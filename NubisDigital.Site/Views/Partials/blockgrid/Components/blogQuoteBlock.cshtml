@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var quoteText = Model.Content.Value<string>("quoteText");
    var quoteAttribution = Model.Content.Value<string>("quoteAttribution");
}

@if (!string.IsNullOrEmpty(quoteText))
{
    <blockquote class="my-8 pl-6 border-l-4 border-sky-500 dark:border-indigo-500 bg-gradient-to-r from-sky-50 to-transparent dark:from-indigo-950 dark:to-transparent py-4 pr-4 rounded-r-lg">
        <p class="text-xl md:text-2xl text-gray-900 dark:text-white font-medium italic mb-2">
            "@quoteText"
        </p>
        @if (!string.IsNullOrEmpty(quoteAttribution))
        {
            <footer class="text-sm text-gray-600 dark:text-gray-400">
                — @quoteAttribution
            </footer>
        }
    </blockquote>
}