@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridItem>
@{
    var code = Model.Content.Value<string>("code");
    var language = Model.Content.Value<string>("language") ?? "plaintext";
}

@if (!string.IsNullOrEmpty(code))
{
    <div class="my-8 rounded-lg overflow-hidden shadow-lg">
        <div class="bg-gray-800 dark:bg-gray-900 px-4 py-2 flex items-center justify-between">
            <span class="text-xs text-gray-400 font-medium">Code</span>
            @if (!string.IsNullOrEmpty(language))
            {
                <span class="text-xs px-2 py-1 rounded bg-gray-700 dark:bg-gray-950 text-gray-300 font-mono">@language</span>
            }
        </div>
        <pre class="bg-gray-900 dark:bg-black p-4 overflow-x-auto"><code class="text-sm text-gray-100 dark:text-gray-300 font-mono leading-relaxed">@code</code></pre>
    </div>
}