@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    var siteRoot = Model?.AncestorOrSelf("siteRoot");
    var siteSettings = siteRoot?.Children?.FirstOrDefault(x => x.ContentType.Alias == "siteSettings");
    var siteTitle = siteSettings?.Value<string>("siteTitle") ?? "Nubis Digital";
}

<!-- Enhanced Footer -->
<footer class="relative z-10 mt-20">
    <!-- Decorative gradient background -->
    <div class="absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-40 left-1/4 h-96 w-96 rounded-full bg-sky-500/10 blur-3xl"></div>
        <div class="absolute -top-20 right-1/4 h-80 w-80 rounded-full bg-indigo-500/10 blur-3xl"></div>
    </div>
    
    <div class="border-t border-slate-200/10 backdrop-blur-sm dark:border-slate-800/50">
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
            <!-- Main Footer Content -->
            <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
                <!-- Brand Column - Spans 4 columns -->
                <div class="lg:col-span-4">
                    <div class="flex items-center gap-3">
                        @{
                            var logo = siteSettings?.Value<IPublishedContent>("siteLogo");
                        }
                        @if (logo != null)
                        {
                            <img src="@logo.Url()" alt="@siteTitle" class="h-12 w-auto" />
                        }
                        else
                        {
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-sky-500 to-indigo-500 text-xl font-bold text-white shadow-lg shadow-sky-500/30">
                                N
                            </div>
                        }
                        <span class="text-2xl font-bold text-slate-900 dark:text-white">Nubis Digital</span>
                    </div>
                    <p class="mt-6 text-base leading-relaxed text-slate-600 dark:text-slate-400">
                        Building the future of Umbraco development with AI-powered workflows and modern design systems.
                    </p>
                    
                    <!-- Social Links with enhanced styling -->
                    <div class="mt-8">
                        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Connect With Us</h4>
                        <div class="flex gap-3">
                            <a href="https://github.com" target="_blank" rel="noopener noreferrer" 
                               class="group flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600 transition-all hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white hover:shadow-lg hover:shadow-sky-500/30 dark:bg-slate-800 dark:text-slate-400" 
                               aria-label="GitHub">
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                                </svg>
                            </a>
                            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" 
                               class="group flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600 transition-all hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white hover:shadow-lg hover:shadow-sky-500/30 dark:bg-slate-800 dark:text-slate-400" 
                               aria-label="Twitter">
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                                </svg>
                            </a>
                            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" 
                               class="group flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600 transition-all hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white hover:shadow-lg hover:shadow-sky-500/30 dark:bg-slate-800 dark:text-slate-400" 
                               aria-label="LinkedIn">
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                                </svg>
                            </a>
                            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" 
                               class="group flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100 text-slate-600 transition-all hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white hover:shadow-lg hover:shadow-sky-500/30 dark:bg-slate-800 dark:text-slate-400" 
                               aria-label="YouTube">
                                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Navigation Columns - Spans 8 columns -->
                <div class="grid gap-8 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-3">
                    <!-- Quick Links -->
                    <div>
                        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Quick Links</h3>
                        <ul class="space-y-3">
                            <li>
                                <a href="/" class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                    Home
                                </a>
                            </li>
                            <li>
                                <a href="/blog" class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                    Blog
                                </a>
                            </li>
                            <li>
                                <a href="/about" class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                    About
                                </a>
                            </li>
                            <li>
                                <a href="/contact" class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                    Contact
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Resources -->
                    <div>
                        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Resources</h3>
                        <ul class="space-y-3">
                            <li>
                                <a href="https://umbraco.com" target="_blank" rel="noopener noreferrer" 
                                   class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                    Umbraco CMS
                                </a>
                            </li>
                            <li>
                                <a href="https://our.umbraco.com" target="_blank" rel="noopener noreferrer" 
                                   class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                    Community
                                </a>
                            </li>
                            <li>
                                <a href="https://docs.umbraco.com" target="_blank" rel="noopener noreferrer" 
                                   class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                    Documentation
                                </a>
                            </li>
                            <li>
                                <a href="https://github.com/umbraco/Umbraco-CMS" target="_blank" rel="noopener noreferrer" 
                                   class="group inline-flex items-center text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">
                                    <svg class="mr-2 h-4 w-4 opacity-0 transition-opacity group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                    </svg>
                                    GitHub
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Newsletter -->
                    <div>
                        <h3 class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-900 dark:text-white">Newsletter</h3>
                        <p class="mb-4 text-sm text-slate-600 dark:text-slate-400">
                            Get the latest insights on Umbraco development and AI workflows.
                        </p>
                        <form class="space-y-3" onsubmit="event.preventDefault(); alert('Newsletter signup coming soon!');">
                            <input type="email" 
                                   placeholder="Enter your email" 
                                   required 
                                   class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition-colors focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:placeholder-slate-500" 
                                   aria-label="Email address"/>
                            <button type="submit" 
                                    class="w-full rounded-lg bg-gradient-to-r from-sky-500 to-indigo-500 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-sky-500/30 transition-all hover:scale-105 hover:shadow-xl hover:shadow-sky-500/40 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2">
                                Subscribe
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Bottom Bar -->
            <div class="mt-12 border-t border-slate-200/10 pt-8 dark:border-slate-800/50">
                <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        @{
                            var copyright = siteSettings?.Value<string>("footerCopyright");
                        }
                        @if (!string.IsNullOrEmpty(copyright))
                        {
                            @Html.Raw(copyright)
                        }
                        else
                        {
                            @:© @DateTime.Now.Year Nubis Digital. Built with <span class="text-red-500">♥</span> using Umbraco CMS.
                        }
                    </p>
                    <div class="flex gap-6">
                        <a href="#" class="text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">Privacy Policy</a>
                        <a href="#" class="text-sm text-slate-600 transition-colors hover:text-sky-500 dark:text-slate-400 dark:hover:text-sky-400">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>