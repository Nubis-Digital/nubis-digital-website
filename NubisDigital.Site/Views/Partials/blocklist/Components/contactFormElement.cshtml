@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    if (Model?.Content == null)
    {
        return;
    }

    var content = Model.Content;
    var formTitle = content.Value<string>("formTitle") ?? "Get in Touch";
    var formDescription = content.Value<string>("formDescription");
    var submitButtonText = content.Value<string>("submitButtonText") ?? "Send Message";
    var successMessage = content.Value<string>("successMessage") ?? "Thank you for your message! We'll get back to you soon.";
    
    // Get settings for section ID
    var settings = Model.Settings;
    var friendlyName = settings?.Value<string>("friendlyName");
    // Use friendlyName if provided, otherwise default to "contact"
    var sectionId = !string.IsNullOrWhiteSpace(friendlyName) ? friendlyName : "contact";
}

<section id="@sectionId" class="relative py-20 sm:py-28 scroll-mt-16 overflow-hidden">
    <!-- Enhanced Decorative gradient orbs with animation -->
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl animate-pulse-slow"></div>
        <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-500/5 rounded-full blur-3xl"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Enhanced Glassmorphism Container with subtle border -->
        <div class="glass-panel ring-1 ring-slate-200/50 dark:ring-slate-700/50">
            <!-- Enhanced Form Header with gradient accent -->
            <div class="text-center mb-16">
                @if (!string.IsNullOrWhiteSpace(formTitle))
                {
                    <div class="inline-flex items-center justify-center mb-6">
                        <div class="h-px w-12 bg-gradient-to-r from-transparent via-sky-500 to-transparent"></div>
                        <div class="mx-4 flex items-center gap-2">
                            <svg class="w-6 h-6 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div class="h-px w-12 bg-gradient-to-r from-transparent via-indigo-500 to-transparent"></div>
                    </div>
                    <h2 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl mb-4 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 dark:from-white dark:via-slate-100 dark:to-white bg-clip-text" style="letter-spacing: -0.02em;">
                        @formTitle
                    </h2>
                }
                
                @if (!string.IsNullOrWhiteSpace(formDescription))
                {
                    <p class="text-lg leading-8 text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
                        @Html.Raw(formDescription)
                    </p>
                }
            </div>

            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
                <!-- Left Column: Contact Info with enhanced styling -->
                <div class="p-6 sm:p-8 lg:p-10 space-y-8">
                    <!-- Contact Information -->
                    <div class="space-y-6">
                        <!-- Email with enhanced hover effect -->
                        <div class="flex items-center gap-4 group cursor-pointer">
                            <div class="flex-shrink-0">
                                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-sky-500/20 group-hover:shadow-xl group-hover:shadow-sky-500/40 transition-all duration-300 group-hover:scale-110">
                                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                    </svg>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">Email</h3>
                                <a href="mailto:hello@nubisdigital.com" class="text-lg font-medium text-slate-900 dark:text-white hover:text-sky-600 dark:hover:text-sky-400 transition-colors break-all">
                                    hello@nubisdigital.com
                                </a>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="border-t border-slate-200/50 dark:border-slate-700/50"></div>

                        <!-- Phone with enhanced hover effect -->
                        <div class="flex items-center gap-4 group cursor-pointer">
                            <div class="flex-shrink-0">
                                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-sky-500/20 group-hover:shadow-xl group-hover:shadow-sky-500/40 transition-all duration-300 group-hover:scale-110">
                                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                    </svg>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">Phone</h3>
                                <a href="tel:+18095551234" class="text-lg font-medium text-slate-900 dark:text-white hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                                    +1 (809) 555-1234
                                </a>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="border-t border-slate-200/50 dark:border-slate-700/50"></div>

                        <!-- Location with enhanced hover effect -->
                        <div class="flex items-center gap-4 group">
                            <div class="flex-shrink-0">
                                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-sky-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-sky-500/20 group-hover:shadow-xl group-hover:shadow-sky-500/40 transition-all duration-300 group-hover:scale-110">
                                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">Location</h3>
                                <p class="text-lg font-medium text-slate-900 dark:text-white">
                                    Santo Domingo, Dominican Republic
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="border-t border-slate-200/50 dark:border-slate-700/50 my-8"></div>

                    <!-- Social Media Links -->
                    <div>
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">Connect With Us</h3>
                        <div class="flex gap-3">
                            <a href="https://github.com/nubisdigital" target="_blank" rel="noopener noreferrer"
                               class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-sky-500/30"
                               aria-label="GitHub">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                                </svg>
                            </a>
                            <a href="https://twitter.com/nubisdigital" target="_blank" rel="noopener noreferrer"
                               class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-sky-500/30"
                               aria-label="Twitter">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                                </svg>
                            </a>
                            <a href="https://linkedin.com/company/nubisdigital" target="_blank" rel="noopener noreferrer"
                               class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center hover:bg-gradient-to-br hover:from-sky-500 hover:to-indigo-500 hover:text-white transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-sky-500/30"
                               aria-label="LinkedIn">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Contact Form with enhanced styling -->
                <div class="p-6 sm:p-8 lg:p-10 bg-slate-50/50 dark:bg-slate-800/20 rounded-2xl">
                    <form id="contact-form" class="space-y-6" novalidate>
                    <!-- Name Field with Floating Label -->
                    <div class="relative group">
                        <input type="text"
                               name="name"
                               id="contact-name"
                               required
                               autocomplete="name"
                               class="peer w-full rounded-xl border-2 border-slate-300 dark:border-slate-600 bg-white/50 dark:bg-slate-900/50 px-4 pt-6 pb-2 text-slate-900 dark:text-white placeholder-transparent transition-all focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/20 hover:border-slate-400 dark:hover:border-slate-500"
                               placeholder="Your full name"
                               aria-required="true"
                               aria-describedby="name-error">
                        <label for="contact-name" 
                               class="absolute left-4 top-2 text-xs font-semibold text-slate-600 dark:text-slate-400 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:font-normal peer-focus:top-2 peer-focus:text-xs peer-focus:font-semibold peer-focus:text-sky-600 dark:peer-focus:text-sky-400">
                            Name <span class="text-red-500" aria-label="required">*</span>
                        </label>
                        <p id="name-error" class="mt-2 text-sm text-red-600 dark:text-red-400 hidden flex items-center gap-1" role="alert">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            <span>Please enter your name</span>
                        </p>
                    </div>

                    <!-- Email Field with Floating Label -->
                    <div class="relative group">
                        <input type="email"
                               name="email"
                               id="contact-email"
                               required
                               autocomplete="email"
                               class="peer w-full rounded-xl border-2 border-slate-300 dark:border-slate-600 bg-white/50 dark:bg-slate-900/50 px-4 pt-6 pb-2 text-slate-900 dark:text-white placeholder-transparent transition-all focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/20 hover:border-slate-400 dark:hover:border-slate-500"
                               placeholder="your.email@example.com"
                               aria-required="true"
                               aria-describedby="email-error">
                        <label for="contact-email" 
                               class="absolute left-4 top-2 text-xs font-semibold text-slate-600 dark:text-slate-400 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:font-normal peer-focus:top-2 peer-focus:text-xs peer-focus:font-semibold peer-focus:text-sky-600 dark:peer-focus:text-sky-400">
                            Email <span class="text-red-500" aria-label="required">*</span>
                        </label>
                        <p id="email-error" class="mt-2 text-sm text-red-600 dark:text-red-400 hidden flex items-center gap-1" role="alert">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                            <span>Please enter a valid email address</span>
                        </p>
                    </div>

                    <!-- Message Field with Floating Label and Character Counter -->
                    <div class="relative group">
                        <textarea name="message"
                                  id="contact-message"
                                  rows="6"
                                  required
                                  maxlength="1000"
                                  class="peer w-full rounded-xl border-2 border-slate-300 dark:border-slate-600 bg-white/50 dark:bg-slate-900/50 px-4 pt-6 pb-2 text-slate-900 dark:text-white placeholder-transparent transition-all resize-none focus:border-sky-500 focus:outline-none focus:ring-4 focus:ring-sky-500/20 hover:border-slate-400 dark:hover:border-slate-500"
                                  placeholder="Tell us about your project..."
                                  aria-required="true"
                                  aria-describedby="message-error message-counter"></textarea>
                        <label for="contact-message" 
                               class="absolute left-4 top-2 text-xs font-semibold text-slate-600 dark:text-slate-400 transition-all peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:font-normal peer-focus:top-2 peer-focus:text-xs peer-focus:font-semibold peer-focus:text-sky-600 dark:peer-focus:text-sky-400">
                            Message <span class="text-red-500" aria-label="required">*</span>
                        </label>
                        <div class="flex items-center justify-between mt-2">
                            <p id="message-error" class="text-sm text-red-600 dark:text-red-400 hidden flex items-center gap-1" role="alert">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                                <span>Please enter your message</span>
                            </p>
                            <p id="message-counter" class="text-xs text-slate-500 dark:text-slate-400" aria-live="polite">
                                <span id="char-count">0</span> / 1000
                            </p>
                        </div>
                    </div>

                    <!-- Submit Button with Enhanced Animation -->
                    <div class="pt-4">
                        <button type="submit"
                                class="group relative w-full overflow-hidden rounded-full bg-gradient-to-r from-sky-500 to-indigo-500 px-8 py-4 text-base font-semibold text-white shadow-xl shadow-sky-500/30 transition-all hover:scale-[1.02] hover:shadow-2xl hover:shadow-sky-500/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100 active:scale-[0.98]"
                                aria-label="Submit contact form">
                            <!-- Button background animation -->
                            <span class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-sky-500 opacity-0 transition-opacity group-hover:opacity-100"></span>
                            
                            <!-- Button content -->
                            <span class="relative inline-flex items-center justify-center gap-2 w-full">
                                <span id="button-text">@submitButtonText</span>
                                <svg id="button-icon" class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
                                    <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
                                </svg>
                                <svg id="button-spinner" class="hidden h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </span>
                        </button>
                    </div>

                    <!-- Success Message -->
                    <div id="success-message" class="hidden rounded-lg bg-green-50 dark:bg-green-900/20 p-4 border border-green-200 dark:border-green-800" role="alert">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-green-800 dark:text-green-200">
                                    @successMessage
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <div id="error-message" class="hidden rounded-lg bg-red-50 dark:bg-red-900/20 p-4 border border-red-200 dark:border-red-800" role="alert">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-red-800 dark:text-red-200">
                                    There was an error submitting your message. Please try again.
                                </p>
                            </div>
                        </div>
                    </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (() => {
        const form = document.getElementById('contact-form');
        if (!form) return;

        const nameInput = document.getElementById('contact-name');
        const emailInput = document.getElementById('contact-email');
        const messageInput = document.getElementById('contact-message');
        const submitButton = form.querySelector('button[type="submit"]');
        const buttonText = document.getElementById('button-text');
        const buttonIcon = document.getElementById('button-icon');
        const buttonSpinner = document.getElementById('button-spinner');
        const successMessage = document.getElementById('success-message');
        const errorMessage = document.getElementById('error-message');
        const charCount = document.getElementById('char-count');

        // Character counter for message field
        messageInput.addEventListener('input', () => {
            const count = messageInput.value.length;
            charCount.textContent = count;
            
            // Change color when approaching limit
            const counter = document.getElementById('message-counter');
            if (count > 900) {
                counter.classList.add('text-red-600', 'dark:text-red-400');
                counter.classList.remove('text-slate-500', 'dark:text-slate-400');
            } else {
                counter.classList.remove('text-red-600', 'dark:text-red-400');
                counter.classList.add('text-slate-500', 'dark:text-slate-400');
            }
        });

        // Validation functions
        const validateName = () => {
            const nameError = document.getElementById('name-error');
            if (!nameInput.value.trim()) {
                nameError.classList.remove('hidden');
                nameInput.classList.add('border-red-500', 'dark:border-red-500');
                nameInput.classList.remove('border-slate-300', 'dark:border-slate-600');
                nameInput.setAttribute('aria-invalid', 'true');
                return false;
            }
            nameError.classList.add('hidden');
            nameInput.classList.remove('border-red-500', 'dark:border-red-500');
            nameInput.classList.add('border-slate-300', 'dark:border-slate-600');
            nameInput.setAttribute('aria-invalid', 'false');
            return true;
        };

        const validateEmail = () => {
            const emailError = document.getElementById('email-error');
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailInput.value.trim() || !emailRegex.test(emailInput.value)) {
                emailError.classList.remove('hidden');
                emailInput.classList.add('border-red-500', 'dark:border-red-500');
                emailInput.classList.remove('border-slate-300', 'dark:border-slate-600');
                emailInput.setAttribute('aria-invalid', 'true');
                return false;
            }
            emailError.classList.add('hidden');
            emailInput.classList.remove('border-red-500', 'dark:border-red-500');
            emailInput.classList.add('border-slate-300', 'dark:border-slate-600');
            emailInput.setAttribute('aria-invalid', 'false');
            return true;
        };

        const validateMessage = () => {
            const messageError = document.getElementById('message-error');
            if (!messageInput.value.trim()) {
                messageError.classList.remove('hidden');
                messageInput.classList.add('border-red-500', 'dark:border-red-500');
                messageInput.classList.remove('border-slate-300', 'dark:border-slate-600');
                messageInput.setAttribute('aria-invalid', 'true');
                return false;
            }
            messageError.classList.add('hidden');
            messageInput.classList.remove('border-red-500', 'dark:border-red-500');
            messageInput.classList.add('border-slate-300', 'dark:border-slate-600');
            messageInput.setAttribute('aria-invalid', 'false');
            return true;
        };

        // Real-time validation on blur
        nameInput.addEventListener('blur', validateName);
        emailInput.addEventListener('blur', validateEmail);
        messageInput.addEventListener('blur', validateMessage);

        // Clear error on input
        nameInput.addEventListener('input', () => {
            if (nameInput.value.trim()) {
                document.getElementById('name-error').classList.add('hidden');
                nameInput.classList.remove('border-red-500', 'dark:border-red-500');
                nameInput.classList.add('border-slate-300', 'dark:border-slate-600');
            }
        });

        emailInput.addEventListener('input', () => {
            if (emailInput.value.trim()) {
                document.getElementById('email-error').classList.add('hidden');
                emailInput.classList.remove('border-red-500', 'dark:border-red-500');
                emailInput.classList.add('border-slate-300', 'dark:border-slate-600');
            }
        });

        messageInput.addEventListener('input', () => {
            if (messageInput.value.trim()) {
                document.getElementById('message-error').classList.add('hidden');
                messageInput.classList.remove('border-red-500', 'dark:border-red-500');
                messageInput.classList.add('border-slate-300', 'dark:border-slate-600');
            }
        });

        // Form submission
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Validate all fields
            const isNameValid = validateName();
            const isEmailValid = validateEmail();
            const isMessageValid = validateMessage();

            if (!isNameValid || !isEmailValid || !isMessageValid) {
                // Focus on first invalid field
                if (!isNameValid) nameInput.focus();
                else if (!isEmailValid) emailInput.focus();
                else if (!isMessageValid) messageInput.focus();
                return;
            }

            // Hide previous messages
            successMessage.classList.add('hidden');
            errorMessage.classList.add('hidden');

            // Show loading state
            submitButton.disabled = true;
            buttonText.textContent = 'Sending...';
            buttonIcon.classList.add('hidden');
            buttonSpinner.classList.remove('hidden');

            try {
                // Simulate form submission (replace with actual API call)
                await new Promise(resolve => setTimeout(resolve, 1500));

                // Show success message with animation
                successMessage.classList.remove('hidden');
                successMessage.style.animation = 'slideIn 0.3s ease-out';
                form.reset();
                charCount.textContent = '0';

                // Reset button state
                buttonText.textContent = '@submitButtonText';
                buttonIcon.classList.remove('hidden');
                buttonSpinner.classList.add('hidden');
                submitButton.disabled = false;

                // Hide success message after 5 seconds
                setTimeout(() => {
                    successMessage.style.animation = 'slideOut 0.3s ease-in';
                    setTimeout(() => {
                        successMessage.classList.add('hidden');
                        successMessage.style.animation = '';
                    }, 300);
                }, 5000);

            } catch (error) {
                // Show error message
                errorMessage.classList.remove('hidden');
                errorMessage.style.animation = 'slideIn 0.3s ease-out';

                // Reset button state
                buttonText.textContent = '@submitButtonText';
                buttonIcon.classList.remove('hidden');
                buttonSpinner.classList.add('hidden');
                submitButton.disabled = false;

                // Hide error message after 5 seconds
                setTimeout(() => {
                    errorMessage.style.animation = 'slideOut 0.3s ease-in';
                    setTimeout(() => {
                        errorMessage.classList.add('hidden');
                        errorMessage.style.animation = '';
                    }, 300);
                }, 5000);
            }
        });

        // Add enhanced animation keyframes
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateY(-10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            @@keyframes slideOut {
                from {
                    opacity: 1;
                    transform: translateY(0);
                }
                to {
                    opacity: 0;
                    transform: translateY(-10px);
                }
            }
            @@keyframes pulse-slow {
                0%, 100% {
                    opacity: 0.1;
                    transform: scale(1);
                }
                50% {
                    opacity: 0.15;
                    transform: scale(1.05);
                }
            }
            .animate-pulse-slow {
                animation: pulse-slow 8s ease-in-out infinite;
            }
        `;
        document.head.appendChild(style);
    })();
</script>