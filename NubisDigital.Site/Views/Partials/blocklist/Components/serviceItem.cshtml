@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    if (Model?.Content == null)
    {
        return;
    }

    var content = Model.Content;
    var title = content.Value<string>("title");
    var description = content.Value<string>("description");
    
    // Get icon image from the new iconImage property
    var iconMedia = content.Value<IPublishedContent>("iconImage");
    string iconUrl = iconMedia?.Url() ?? "";
    string iconAlt = iconMedia?.Value<string>("altText") ?? title ?? "Service icon";
}

<div class="group flex flex-col items-start h-full">
    <!-- Enhanced Icon Container with Hover Effects -->
    <div class="relative">
        <div class="rounded-xl p-4 ring-1 ring-sky-500/20 bg-gradient-to-br from-sky-500/10 to-indigo-500/10 transition-all duration-500 group-hover:ring-sky-500/40 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-sky-500/20 dark:from-sky-400/10 dark:to-indigo-400/10 dark:ring-sky-400/20">
            @if (!string.IsNullOrWhiteSpace(iconUrl))
            {
                <img src="@iconUrl"
                     alt="@iconAlt"
                     class="h-12 w-12 object-contain transition-transform duration-500 group-hover:rotate-6 group-hover:scale-110"
                     loading="lazy" />
            }
            else
            {
                <!-- Fallback icon if no image is provided -->
                <div class="h-12 w-12 flex items-center justify-center text-sky-500 dark:text-sky-400">
                    <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            }
        </div>
        <!-- Decorative pulse effect on hover -->
        <div class="absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500 group-hover:opacity-100">
            <div class="absolute inset-0 animate-ping rounded-xl bg-gradient-to-br from-sky-500/10 to-indigo-500/10 ring-1 ring-sky-500/20 opacity-20"></div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="mt-6 flex-1">
        @if (!string.IsNullOrWhiteSpace(title))
        {
            <h3 class="text-xl font-bold text-slate-900 transition-colors duration-300 group-hover:text-sky-600 dark:text-white dark:group-hover:text-sky-400">
                @title
            </h3>
        }
        @if (!string.IsNullOrWhiteSpace(description))
        {
            <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">
                @description
            </p>
        }
    </div>

    <!-- Decorative bottom accent line -->
    <div class="mt-6 h-1 w-0 rounded-full bg-gradient-to-r from-sky-500 to-indigo-500 transition-all duration-500 group-hover:w-full"></div>
</div>

<style>
    @@keyframes ping {
        75%, 100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .animate-ping {
        animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @@media (prefers-reduced-motion: reduce) {
        .animate-ping {
            animation: none;
        }
    }
</style>