@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    if (Model?.Content == null)
    {
        return;
    }

    var content = Model.Content;
    var icon = content.Value<string>("icon") ?? "icon-check";
    var title = content.Value<string>("title");
    var description = content.Value<string>("description");
    
    // Map icon names to colors
    var iconColorClass = icon switch
    {
        "icon-check" => "bg-sky-500/10 ring-sky-500/20 text-sky-500 dark:bg-sky-400/10 dark:ring-sky-400/20 dark:text-sky-400",
        "icon-lightbulb-active" => "bg-indigo-500/10 ring-indigo-500/20 text-indigo-500 dark:bg-indigo-400/10 dark:ring-indigo-400/20 dark:text-indigo-400",
        "icon-rocket" => "bg-purple-500/10 ring-purple-500/20 text-purple-500 dark:bg-purple-400/10 dark:ring-purple-400/20 dark:text-purple-400",
        "icon-briefcase" => "bg-blue-500/10 ring-blue-500/20 text-blue-500 dark:bg-blue-400/10 dark:ring-blue-400/20 dark:text-blue-400",
        "icon-settings" => "bg-slate-500/10 ring-slate-500/20 text-slate-500 dark:bg-slate-400/10 dark:ring-slate-400/20 dark:text-slate-400",
        "icon-trophy" => "bg-amber-500/10 ring-amber-500/20 text-amber-500 dark:bg-amber-400/10 dark:ring-amber-400/20 dark:text-amber-400",
        _ => "bg-sky-500/10 ring-sky-500/20 text-sky-500 dark:bg-sky-400/10 dark:ring-sky-400/20 dark:text-sky-400"
    };
}

<div class="flex flex-col items-start">
    <div class="rounded-lg p-3 ring-1 @iconColorClass">
        <svg class="h-6 w-6" aria-hidden="true">
            <use href="#@icon"></use>
        </svg>
    </div>
    @if (!string.IsNullOrWhiteSpace(title))
    {
        <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">@title</h3>
    }
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <p class="mt-2 text-base leading-7 text-slate-600 dark:text-slate-300">@description</p>
    }
</div>