@using Microsoft.AspNetCore.Html
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    if (Model?.Content == null)
    {
        return;
    }

    var content = Model.Content;
    var sectionTitle = content.Value<string>("sectionTitle");
    var richTextContent = content.Value("content");
    var image = content.Value<IPublishedContent>("image");
    var imagePosition = content.Value<string>("imagePosition") ?? "left";
    
    // Determine layout classes based on image position
    var hasImage = image != null;
    var isFullscreen = imagePosition == "fullscreen";
    var imageOnRight = imagePosition == "right";
    var imageOnLeft = imagePosition == "left" || string.IsNullOrWhiteSpace(imagePosition);
    var hasContent = richTextContent != null;
}

<section class="py-16 sm:py-20 lg:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        @if (isFullscreen && hasImage)
        {
            <!-- Fullscreen layout with background image -->
            <div class="relative overflow-hidden rounded-3xl min-h-[500px] lg:min-h-[600px] flex items-center" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.05) 0%, rgba(129, 140, 248, 0.05) 100%);">
                <div class="absolute inset-0 z-0">
                    <img src="@image.Url()" alt="@(image.Value<string>("altText") ?? sectionTitle)"
                         class="w-full h-full object-cover opacity-15 dark:opacity-10" />
                </div>
                <div class="absolute inset-0 bg-gradient-to-br from-white/60 via-white/40 to-transparent dark:from-slate-900/60 dark:via-slate-900/40 backdrop-blur-sm"></div>
                <div class="relative z-10 w-full px-8 py-12 lg:px-16 lg:py-20">
                    @if (!string.IsNullOrWhiteSpace(sectionTitle))
                    {
                        <h2 class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl mb-8" style="letter-spacing: -0.02em;">
                            @sectionTitle
                        </h2>
                    }
                    @if (hasContent)
                    {
                        <div class="prose prose-xl prose-slate dark:prose-invert max-w-4xl prose-headings:font-semibold prose-headings:tracking-tight prose-h2:text-3xl prose-h3:text-2xl prose-h4:text-xl prose-p:text-slate-600 dark:prose-p:text-slate-300 prose-strong:text-slate-900 dark:prose-strong:text-white prose-li:text-slate-600 dark:prose-li:text-slate-300">
                            @Html.Raw(richTextContent)
                        </div>
                    }
                </div>
            </div>
        }
        else if (hasImage)
        {
            <!-- Two-column layout with image -->
            <div class="overflow-hidden rounded-3xl" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.03) 0%, rgba(129, 140, 248, 0.03) 100%);">
                <div class="backdrop-blur-xl bg-white/80 dark:bg-slate-900/80 border border-white/20 dark:border-slate-700/30 shadow-xl">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 @(imageOnRight ? "" : "lg:grid-flow-dense")">
                        <!-- Content Column -->
                        <div class="@(imageOnRight ? "lg:col-start-1" : "lg:col-start-2") p-8 lg:p-12 xl:p-16 flex flex-col justify-center">
                            @if (!string.IsNullOrWhiteSpace(sectionTitle))
                            {
                                <h2 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl lg:text-5xl mb-6" style="letter-spacing: -0.02em;">
                                    @sectionTitle
                                </h2>
                            }
                            @if (hasContent)
                            {
                                <div class="prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-slate-600 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-strong:text-slate-900 dark:prose-strong:text-white prose-li:text-slate-600 dark:prose-li:text-slate-300">
                                    @Html.Raw(richTextContent)
                                </div>
                            }
                        </div>
                        
                        <!-- Image Column -->
                        <div class="@(imageOnRight ? "lg:col-start-2" : "lg:col-start-1") relative min-h-[300px] lg:min-h-full">
                            <img src="@image.Url()" alt="@(image.Value<string>("altText") ?? sectionTitle)"
                                 class="absolute inset-0 w-full h-full object-cover" />
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Content only layout (no image) -->
            <div class="max-w-5xl mx-auto">
                <div class="overflow-hidden rounded-3xl backdrop-blur-xl bg-white/80 dark:bg-slate-900/80 border border-white/20 dark:border-slate-700/30 shadow-xl p-8 lg:p-12 xl:p-16" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.03) 0%, rgba(129, 140, 248, 0.03) 100%);">
                    @if (!string.IsNullOrWhiteSpace(sectionTitle))
                    {
                        <h2 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl lg:text-5xl mb-8" style="letter-spacing: -0.02em;">
                            @sectionTitle
                        </h2>
                    }
                    @if (hasContent)
                    {
                        <div class="prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3 prose-h4:text-lg prose-h4:mt-5 prose-h4:mb-2 prose-p:text-slate-600 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-p:mb-4 prose-strong:text-slate-900 dark:prose-strong:text-white prose-strong:font-semibold prose-li:text-slate-600 dark:prose-li:text-slate-300 prose-ul:my-4 prose-li:my-1">
                            @Html.Raw(richTextContent)
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>