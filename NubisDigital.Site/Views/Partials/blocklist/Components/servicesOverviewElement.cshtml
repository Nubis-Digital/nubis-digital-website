@using Microsoft.AspNetCore.Html
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    if (Model?.Content == null)
    {
        return;
    }

    var content = Model.Content;
    var headline = content.Value<string>("headline");
    var richText = content.Value<IHtmlContent>("content");
    var servicesLink = content.Value<IPublishedContent>("servicesLink");
}

<section class="section-padding">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
            <div>
                @if (!string.IsNullOrWhiteSpace(headline))
                {
                    <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-4xl">
                        @headline
                    </h2>
                }

                @if (richText is IHtmlContent contentRichText)
                {
                    <div class="mt-6 prose prose-lg prose-slate dark:prose-invert max-w-none">
                        @contentRichText
                    </div>
                }

                @if (servicesLink != null)
                {
                    <div class="mt-8">
                        <a href="@servicesLink.Url()" class="inline-flex items-center text-sky-500 hover:text-sky-400 font-semibold transition-colors duration-200">
                            Explore our services
                            <svg class="ml-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M12.293 3.293a1 1 0 011.414 0L18 7.586a1 1 0 010 1.414l-4.293 4.293a1 1 0 11-1.414-1.414L14.586 9H4a1 1 0 110-2h10.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                            </svg>
                        </a>
                    </div>
                }
            </div>

            <div class="glass-panel">
                <h3 class="text-xl font-semibold text-slate-900 dark:text-slate-100">Why partner with Nubis Digital?</h3>
                <ul class="mt-6 space-y-4 text-slate-600 dark:text-slate-300">
                    <li class="flex items-start">
                        <span class="mr-3 inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-sky-500/10 text-sky-500">
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 00-1.414-1.414L8 11.172 4.707 7.879A1 1 0 003.293 9.293l4 4a1 1 0 001.414 0l8-8z" clip-rule="evenodd" />
                            </svg>
                        </span>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-slate-100">Deep Umbraco expertise</p>
                            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Years of experience crafting tailor-made Umbraco solutions for ambitious teams.</p>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3 inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-indigo-500/10 text-indigo-500">
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-4.5a1 1 0 112 0v1a1 1 0 11-2 0v-1zm.293-7.707a1 1 0 011.414 0l1 1a1 1 0 11-1.414 1.414L11 8.414V11a1 1 0 11-2 0V8.414L8.707 7.707a1 1 0 010-1.414l1-1z" clip-rule="evenodd" />
                            </svg>
                        </span>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-slate-100">Frictionless delivery</p>
                            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Collaborative workflows and transparent timelines keep projects on track.</p>
                        </div>
                    </li>
                    <li class="flex items-start">
                        <span class="mr-3 inline-flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-purple-500/10 text-purple-500">
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2V7H5V5h2V3H5zm8 0h-2v2h2v2h-2v2h2a2 2 0 002-2V5a2 2 0 00-2-2zm-2 12h2a2 2 0 002-2v-2a2 2 0 00-2-2h-2v2h2v2h-2v2zm-4-2H5v-2h2V9H5a2 2 0 00-2 2v2a2 2 0 002 2h2v-2z" clip-rule="evenodd" />
                            </svg>
                        </span>
                        <div>
                            <p class="font-semibold text-slate-900 dark:text-slate-100">Scalable architecture</p>
                            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Future-ready foundations that scale with your content and marketing ambitions.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>