@using System.Globalization
@using System.Linq
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListItem>

@{
    if (Model?.Content == null)
    {
        return;
    }

    var blockContent = Model.Content;
    var headline = blockContent.Value<string>("headline");
    var requestedCount = blockContent.Value<int?>("numberOfPostsToShow") ?? 3;
    var postsToTake = requestedCount <= 0 ? 3 : requestedCount;
    var blogRoot = blockContent.Value<IPublishedContent>("blogListLink");

    // Auto-discover blog list page if not manually selected
    if (blogRoot == null)
    {
        // Try to find a blog list page by document type alias
        var currentPage = Umbraco.AssignedContentItem;
        if (currentPage != null)
        {
            blogRoot = currentPage.Root().DescendantsOrSelf()
                .FirstOrDefault(x => x.ContentType.Alias == "blogList");
        }
    }

    var posts = Enumerable.Empty<IPublishedContent>();

    if (blogRoot != null)
    {
        posts = blogRoot.Children?
            .Where(x => x.IsVisible() && x.ContentType.Alias == "blogPost")
            .OrderByDescending(x => x.Value<DateTime?>("publishDate") ?? x.UpdateDate)
            .Take(postsToTake)
            .ToList() ?? Enumerable.Empty<IPublishedContent>();
    }
}

<section class="py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div class="max-w-2xl">
                @if (!string.IsNullOrWhiteSpace(headline))
                {
                    <h2 class="text-4xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-5xl" style="letter-spacing: -0.02em;">
                        @headline
                    </h2>
                }
                <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
                    Curated insights from the Nubis Digital build—with fresh reflections every time the project evolves.
                </p>
            </div>

            @if (blogRoot != null)
            {
                <a href="@blogRoot.Url()" class="group inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-sky-500 to-indigo-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-sky-500/30 transition-all hover:scale-105 hover:shadow-xl hover:shadow-sky-500/40 dark:shadow-sky-500/20">
                    View all posts
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h9.69L10.22 6.03a.75.75 0 011.06-1.06l4.5 4.5a.75.75 0 010 1.06l-4.5 4.5a.75.75 0 11-1.06-1.06l3.22-3.22H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                    </svg>
                </a>
            }
        </div>

        @if (posts?.Any() == true)
        {
            <div class="mt-16 grid gap-8 sm:mt-20 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var post in posts)
                {
                    var postTitle = post.Name;
                    var postSubtitle = post.Value<string>("subtitle");
                    var featureImage = post.Value<MediaWithCrops>("featureImage");
                    var featureImageUrl = featureImage?.GetCropUrl(width: 800, height: 500);
                    var publishDate = post.Value<DateTime?>("publishDate") ?? post.CreateDate;
                    var author = post.Value<string>("author");
                    var tags = post.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
                    var formattedDate = publishDate.ToString("MMMM d, yyyy", CultureInfo.CurrentCulture);

                    <a href="@post.Url()" class="group block h-full">
                        <article class="flex h-full flex-col overflow-hidden rounded-2xl bg-white/95 shadow-xl shadow-slate-900/10 ring-1 ring-slate-900/10 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-sky-500/20 hover:ring-sky-500/50 dark:bg-slate-900/60 dark:ring-white/10 dark:hover:ring-sky-400/50">
                            @if (!string.IsNullOrWhiteSpace(featureImageUrl))
                            {
                                <div class="relative aspect-[16/10] overflow-hidden">
                                    <img src="@featureImageUrl"
                                         alt="@postTitle"
                                         class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent"></div>
                                    
                                    @if (tags.Any())
                                    {
                                        <div class="absolute bottom-4 left-4 flex flex-wrap gap-2">
                                            @foreach (var tag in tags.Where(t => !string.IsNullOrWhiteSpace(t)).Take(2))
                                            {
                                                <span class="inline-flex items-center rounded-full bg-sky-500/90 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-sm">
                                                    @tag
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="flex flex-1 flex-col p-8">
                                <div class="flex items-center gap-3 text-sm">
                                    <time class="font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
                                        @formattedDate
                                    </time>
                                    @if (!string.IsNullOrWhiteSpace(author))
                                    {
                                        <span class="text-slate-400 dark:text-slate-500">•</span>
                                        <span class="flex items-center gap-1.5 font-medium text-slate-600 dark:text-slate-300">
                                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M10 2a4 4 0 100 8 4 4 0 000-8zm-6 9a6 6 0 0112 0v.333C16 13.806 13.866 16 11.333 16H8.667C6.134 16 4 13.806 4 11.333V11z" clip-rule="evenodd" />
                                            </svg>
                                            @author
                                        </span>
                                    }
                                </div>

                                <h3 class="mt-4 text-2xl font-bold leading-tight text-slate-900 transition-colors duration-200 group-hover:text-sky-500 dark:text-white dark:group-hover:text-sky-400">
                                    @postTitle
                                </h3>

                                @if (!string.IsNullOrWhiteSpace(postSubtitle))
                                {
                                    <p class="mt-3 line-clamp-2 text-base leading-relaxed text-slate-600 dark:text-slate-300">
                                        @postSubtitle
                                    </p>
                                }

                                <div class="mt-auto pt-6">
                                    <span class="inline-flex items-center gap-2 text-sm font-semibold text-sky-500 transition-colors group-hover:text-sky-600 dark:text-sky-400 dark:group-hover:text-sky-300">
                                        Read article
                                        <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h9.69L10.22 6.03a.75.75 0 011.06-1.06l4.5 4.5a.75.75 0 010 1.06l-4.5 4.5a.75.75 0 11-1.06-1.06l3.22-3.22H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </article>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="mt-16 sm:mt-20">
                <div class="rounded-2xl bg-white/95 p-12 text-center shadow-xl ring-1 ring-slate-900/10 backdrop-blur-xl dark:bg-slate-900/60 dark:ring-white/10">
                    <svg class="mx-auto h-12 w-12 text-slate-400 dark:text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                    @if (blogRoot == null)
                    {
                        <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">No blog found</h3>
                        <p class="mt-2 text-slate-600 dark:text-slate-300">
                            The system will automatically discover your blog posts once you create a Blog List page.
                        </p>
                    }
                    else
                    {
                        <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">No posts yet</h3>
                        <p class="mt-2 text-slate-600 dark:text-slate-300">
                            Publish your first blog post to showcase your insights and build updates here.
                        </p>
                    }
                </div>
            </div>
        }
    </div>
</section>