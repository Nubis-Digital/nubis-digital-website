@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions

@{
    Layout = "master.cshtml";

    var siteTitle = Model.Value<string>("siteTitle");
    var mainContent = Model.Value<BlockListModel>("mainContent");
}

<main class="relative min-h-screen transition-colors duration-300">
    <div class="gradient-bg">
        <div class="gradient-orb-1"></div>
        <div class="gradient-orb-2"></div>
    </div>

    <div class="relative z-10">
        @if (!string.IsNullOrWhiteSpace(siteTitle))
        {
            <header class="sr-only">
                <h1>@siteTitle</h1>
            </header>
        }

        @if (mainContent is { Count: > 0 })
        {
            @await Html.PartialAsync("blocklist/default", mainContent)
        }
        else
        {
            <section class="section-padding">
                <div class="container-wrapper">
                    <div class="glass-panel max-w-2xl mx-auto text-center">
                        <h2 class="text-heading-2 mb-4">Build in progress</h2>
                        <p class="text-body">
                            Add blocks to the <strong>Main Content</strong> area to bring the home page to life.
                        </p>
                    </div>
                </div>
            </section>
        }
    </div>
</main>
