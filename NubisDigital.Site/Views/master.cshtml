    <meta name="facebook-domain-verification" content="fu5y9x15vditw3hd1i9qv7l9y1nl5o" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.3s, color 0.3s;
        }
    </style>
</head>

