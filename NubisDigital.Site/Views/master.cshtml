@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>
@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    var siteRoot = Model.AncestorOrSelf("siteRoot");
    var siteSettings = siteRoot?.FirstChild(x => x.ContentType.Alias == "siteSettings");
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var langCode = currentCulture.Split('-')[0]; // Get just the language part (e.g., "en" from "en-US")
    var pageTitle = Model.Value<string>("pageTitle") ?? Model.Name;
    var siteTitle = siteSettings?.Value<string>("siteTitle") ?? "Nubis Digital";
}
<!DOCTYPE html>
<html lang="@langCode" class="dark" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@pageTitle - @siteTitle</title>

    <meta-fields></meta-fields>
    
    @* Add hreflang tags for SEO *@
    @if (Model is Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent publishedContent)
    {
        var cultures = publishedContent.Cultures?.Keys?.ToList() ?? new List<string>();
        foreach (var culture in cultures)
        {
            var cultureUrl = publishedContent.Url(culture,UrlMode.Absolute);
            <link rel="alternate" hreflang="@culture" href="@cultureUrl" />
        }
        
        @* Add x-default for default language *@
        if (cultures.Any())
        {
            var defaultCulture = cultures.FirstOrDefault(c => c.StartsWith("en")) ?? cultures.First();
            var defaultUrl = publishedContent.Url(defaultCulture, UrlMode.Absolute);
            <link rel="alternate" hreflang="x-default" href="@defaultUrl" />
        }
    }
    
    <render-script position="HeadBottom"></render-script>

    <script>
        window.tailwind = window.tailwind || {};
        window.tailwind.config = {
            darkMode: 'class'
        };
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/index.css" />

    <meta name="facebook-domain-verification" content="fu5y9x15vditw3hd1i9qv7l9y1nl5o" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.3s, color 0.3s;
        }
    </style>
</head>

<body class="min-h-screen antialiased transition-colors duration-300">
    <render-script position="BodyTop"></render-script>

    <div role="presentation" aria-hidden="true">
        <!-- 3D Canvas Background -->
        <div id="three-canvas-container"></div>
    </div>

    @{
        var currentPage = Model as Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent;
    }

    @if (currentPage is not null)
    {
        @await Html.PartialAsync("_MainNavigation", currentPage)
    }

    <div id="main-content" class="relative z-10">
        @RenderBody()
    </div>

    @await Html.PartialAsync("_Footer", currentPage)

    <render-script position="BodyBottom"></render-script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <script>
        // --- THEME MANAGEMENT ---
        let headMaterial, nodeMaterial, lineMaterial;

        // Function to apply a theme and update 3D object colors
        function setTheme(theme) {
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.remove('light', 'dark');
            document.documentElement.classList.add(theme);
            
            // Wait for CSS variables to be applied, then update materials
            requestAnimationFrame(() => {
                if (headMaterial && nodeMaterial && lineMaterial) {
                    const newColor1 = new THREE.Color(getComputedStyle(document.body).getPropertyValue('--logo-color-1').trim());
                    const newColor2 = new THREE.Color(getComputedStyle(document.body).getPropertyValue('--logo-color-2').trim());
                    
                    headMaterial.color.set(newColor1);
                    nodeMaterial.color.set(newColor1);
                    nodeMaterial.emissive.set(newColor1);
                    lineMaterial.color.set(newColor2);
                }
            });
        }
        
        // Load saved theme or set based on user preference
        const userPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const savedTheme = localStorage.getItem('theme');
        setTheme(savedTheme || (userPrefersDark ? 'dark' : 'light'));

        // Theme toggle function (called from navigation)
        window.toggleTheme = function() {
            const currentTheme = document.documentElement.dataset.theme;
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            localStorage.setItem('theme', newTheme);
            setTheme(newTheme);
        };
        
        // --- 3D SCENE SETUP ---
        let scene, camera, renderer, logoGroup;
        const mouse = new THREE.Vector2();

        function initThree() {
            const container = document.getElementById('three-canvas-container');
            if (!container) return;
            
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setClearColor(0x000000, 0);
            container.appendChild(renderer.domElement);

            logoGroup = new THREE.Group();
            
            // Define materials for the logo components
            headMaterial = new THREE.MeshStandardMaterial({
                color: 0xffffff,
                metalness: 0.3,
                roughness: 0.4,
                transparent: true,
                opacity: 0.08,
                wireframe: false
            });
            nodeMaterial = new THREE.MeshStandardMaterial({
                color: 0xffffff,
                metalness: 0.5,
                roughness: 0.2,
                emissive: 0xffffff,
                emissiveIntensity: 0.3
            });
            lineMaterial = new THREE.LineBasicMaterial({
                color: 0xffffff,
                transparent: true,
                opacity: 0.35,
                linewidth: 1
            });

            // Create a more organic head shape resembling a brain
            const headShape = new THREE.Shape();
            // Start from bottom center
            headShape.moveTo(0, -2.5);
            // Left side of head with more organic curves
            headShape.bezierCurveTo(-0.8, -2.5, -1.8, -2, -2.2, -1);
            headShape.bezierCurveTo(-2.5, 0, -2.8, 1.5, -2.5, 2.5);
            headShape.bezierCurveTo(-2.2, 3.5, -1.5, 4.2, -0.5, 4.5);
            // Top of head
            headShape.bezierCurveTo(0, 4.6, 0.5, 4.5, 0.5, 4.5);
            // Right side of head
            headShape.bezierCurveTo(1.5, 4.2, 2.2, 3.5, 2.5, 2.5);
            headShape.bezierCurveTo(2.8, 1.5, 2.5, 0, 2.2, -1);
            headShape.bezierCurveTo(1.8, -2, 0.8, -2.5, 0, -2.5);
            
            const extrudeSettings = {
                depth: 0.5,
                bevelEnabled: true,
                bevelSegments: 4,
                steps: 3,
                bevelSize: 0.2,
                bevelThickness: 0.15
            };
            const headGeometry = new THREE.ExtrudeGeometry(headShape, extrudeSettings);
            const head = new THREE.Mesh(headGeometry, headMaterial);
            head.position.z = -0.25;
            logoGroup.add(head);

            // Create a neural network with more nodes distributed throughout the head
            const nodePositions = [
                // Top layer (frontal cortex area)
                { x: 0, y: 3.2, z: 0, size: 0.15 },
                { x: -1, y: 3, z: 0.1, size: 0.12 },
                { x: 1, y: 3, z: -0.1, size: 0.12 },
                
                // Upper middle layer (parietal area)
                { x: -1.5, y: 2, z: 0, size: 0.14 },
                { x: 0, y: 2.2, z: 0.2, size: 0.13 },
                { x: 1.5, y: 2, z: 0, size: 0.14 },
                
                // Central layer (thalamus/central processing)
                { x: -0.8, y: 1, z: 0.1, size: 0.16 },
                { x: 0, y: 0.8, z: 0, size: 0.18 }, // Central hub
                { x: 0.8, y: 1, z: -0.1, size: 0.16 },
                
                // Lower middle layer (temporal area)
                { x: -1.6, y: 0, z: 0.1, size: 0.13 },
                { x: 1.6, y: 0, z: -0.1, size: 0.13 },
                
                // Lower layer (cerebellum/brainstem area)
                { x: -1, y: -1, z: 0, size: 0.12 },
                { x: 0, y: -1.2, z: 0.1, size: 0.14 },
                { x: 1, y: -1, z: 0, size: 0.12 },
                
                // Additional scattered neurons for depth
                { x: -0.5, y: 1.8, z: 0.3, size: 0.1 },
                { x: 0.5, y: 1.8, z: -0.3, size: 0.1 },
                { x: -1.2, y: 0.5, z: -0.2, size: 0.11 },
                { x: 1.2, y: 0.5, z: 0.2, size: 0.11 }
            ];
            
            const nodes = nodePositions.map(pos => {
                const nodeGeometry = new THREE.SphereGeometry(pos.size, 16, 16);
                const node = new THREE.Mesh(nodeGeometry, nodeMaterial.clone());
                node.position.set(pos.x, pos.y, pos.z);
                node.userData.originalSize = pos.size;
                node.userData.pulsePhase = Math.random() * Math.PI * 2; // Random phase for pulsing
                logoGroup.add(node);
                return node;
            });
            
            // Create neural connections with a more organic network pattern
            const connections = [
                // Top layer connections
                [0, 1], [0, 2], [1, 2],
                // Top to upper middle
                [0, 4], [1, 4], [2, 4],
                [1, 3], [2, 5],
                // Upper middle to central hub
                [3, 7], [4, 7], [5, 7],
                [3, 6], [5, 8],
                // Central hub connections
                [6, 7], [7, 8],
                [7, 12], // Central to lower
                // Central to sides
                [6, 9], [8, 10],
                // Lower connections
                [9, 11], [10, 13],
                [11, 12], [12, 13],
                // Depth connections
                [4, 14], [4, 15],
                [6, 16], [8, 17],
                // Cross connections for complexity
                [3, 9], [5, 10],
                [14, 15], [16, 17]
            ];
            
            connections.forEach(conn => {
                const points = [nodes[conn[0]].position, nodes[conn[1]].position];
                const lineGeometry = new THREE.BufferGeometry().setFromPoints(points);
                const line = new THREE.Line(lineGeometry, lineMaterial.clone());
                line.userData.connectionIndex = conn;
                logoGroup.add(line);
            });
            
            // Store nodes for animation
            logoGroup.userData.nodes = nodes;
            
            scene.add(logoGroup);

            // Add lighting
            scene.add(new THREE.AmbientLight(0xffffff, 0.6));
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(5, 5, 5);
            scene.add(directionalLight);
            
            // Set initial camera position and apply theme colors
            camera.position.set(0, 0, 8);
            setTheme(document.documentElement.dataset.theme);
            
            // Start the animation loop
            animate();
        }

        // Animation loop
        function animate() {
            requestAnimationFrame(animate);
            const time = Date.now() * 0.001; // Time in seconds

            // Gently rotate the logo based on mouse position for subtle interaction
            if (logoGroup) {
                logoGroup.rotation.y += (mouse.x * 0.5 - logoGroup.rotation.y) * 0.05;
                logoGroup.rotation.x += (-mouse.y * 0.5 - logoGroup.rotation.x) * 0.05;
                
                // Add a slow, constant rotation
                logoGroup.rotation.y += 0.0003;
                
                // Animate neurons with pulsing effect
                if (logoGroup.userData.nodes) {
                    logoGroup.userData.nodes.forEach((node, index) => {
                        // Create pulsing effect with different phases for each neuron
                        const pulseSpeed = 2.0;
                        const pulseAmount = 0.15;
                        const pulse = Math.sin(time * pulseSpeed + node.userData.pulsePhase) * pulseAmount + 1;
                        node.scale.setScalar(pulse);
                        
                        // Vary emissive intensity for "firing" neurons
                        const emissiveIntensity = (Math.sin(time * 1.5 + node.userData.pulsePhase) + 1) * 0.2 + 0.1;
                        node.material.emissiveIntensity = emissiveIntensity;
                        
                        // Add subtle floating motion
                        const floatAmount = 0.02;
                        node.position.y += Math.sin(time * 0.5 + index) * floatAmount * 0.01;
                    });
                }
                
                // Animate neural connection lines with opacity pulsing
                logoGroup.children.forEach(child => {
                    if (child instanceof THREE.Line && child.userData.connectionIndex) {
                        const [start, end] = child.userData.connectionIndex;
                        const pulsePhase = (start + end) * 0.5;
                        const opacity = (Math.sin(time * 1.2 + pulsePhase) + 1) * 0.15 + 0.2;
                        child.material.opacity = opacity;
                    }
                });
            }

            renderer.render(scene, camera);
        }

        // --- EVENT LISTENERS ---
        function onWindowResize() {
            if (camera && renderer) {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            }
        }

        function onMouseMove(event) {
            // Normalize mouse coordinates (-1 to +1)
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
        }

        window.addEventListener('resize', onWindowResize);
        window.addEventListener('mousemove', onMouseMove);
        
        // Initialize the 3D scene if Three.js is loaded
        if (typeof THREE !== 'undefined') {
            // Wait for DOM to be ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initThree);
            } else {
                initThree();
            }
        } else {
            console.error("Three.js library not found.");
        }
    </script>

</body>

</html>