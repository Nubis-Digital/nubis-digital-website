@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>
@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    var siteRoot = Model.AncestorOrSelf("siteRoot");
    var siteSettings = siteRoot?.FirstChild(x => x.ContentType.Alias == "siteSettings");
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var langCode = currentCulture.Split('-')[0]; // Get just the language part (e.g., "en" from "en-US")
    var pageTitle = Model.Value<string>("pageTitle") ?? Model.Name;
    var siteTitle = siteSettings?.Value<string>("siteTitle") ?? "Nubis Digital";
}
<!DOCTYPE html>
<html lang="@langCode" class="dark" data-theme="dark">

<head>
    @* SEO Meta Tags *@
    @await Html.PartialAsync("_SeoMetaTags", Model)
    
    @* Add hreflang tags for multilingual SEO *@
    @if (Model is Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent publishedContent)
    {
        var cultures = publishedContent.Cultures?.Keys?.ToList() ?? new List<string>();
        foreach (var culture in cultures)
        {
            var cultureUrl = publishedContent.Url(culture, UrlMode.Absolute);
            <link rel="alternate" hreflang="@culture" href="@cultureUrl" />
        }
        
        @* Add x-default for default language *@
        if (cultures.Any())
        {
            var defaultCulture = cultures.FirstOrDefault(c => c.StartsWith("en")) ?? cultures.First();
            var defaultUrl = publishedContent.Url(defaultCulture, UrlMode.Absolute);
            <link rel="alternate" hreflang="x-default" href="@defaultUrl" />
        }
    }
    
    <render-script position="HeadBottom"></render-script>

    @* Tailwind Configuration *@
    <script src="~/js/tailwind-config.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/index.css" />

    <meta name="facebook-domain-verification" content="fu5y9x15vditw3hd1i9qv7l9y1nl5o" />
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color 0.3s, color 0.3s;
        }
    </style>
</head>

<body class="min-h-screen antialiased transition-colors duration-300">
    @* <render-script position="BodyTop"></render-script> *@

    <div role="presentation" aria-hidden="true">
        <!-- 3D Canvas Background -->
        <div id="three-canvas-container"></div>
    </div>

    @{
        var currentPage = Model as Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent;
    }

    @if (currentPage is not null)
    {
        @await Html.PartialAsync("_MainNavigation", currentPage)
    }

    <div id="main-content" class="relative z-10">
        @RenderBody()
    </div>

    @await Html.PartialAsync("_Footer", currentPage)

    @* <render-script position="BodyBottom"></render-script> *@
    
    @* External Libraries *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    @* Theme Management *@
    <script src="~/js/theme-manager.js"></script>
    
    @* 3D Neural Network Background *@
    <script src="~/js/neural-network-3d.js"></script>
    
    @* Global Liquid Glass Effect for All Interactive Elements *@
    <script src="~/js/global-liquid-glass.js"></script>
    
    @* 3D Scroll Parallax Integration *@
    <script src="~/js/scroll-parallax-3d.js"></script>

</body>

</html>