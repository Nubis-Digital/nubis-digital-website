          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EBy assigning content pickers for every CTA, editors can retarget journeys without touching code. Home now points to Blog, Services, and Contact via UDI references, and those destinations are guaranteed to stay published before we launch.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "4020c981-3adb-468c-80bb-0869718c098e",
