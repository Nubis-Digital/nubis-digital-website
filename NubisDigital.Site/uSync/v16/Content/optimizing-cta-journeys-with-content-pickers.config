      "udi": null,
      "values": [
        {
          "alias": "code",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "hero.PrimaryCtaLink = home.Value\u003CIPublishedContent\u003E(\u0022primaryCtaLink\u0022);\ncta.ButtonLink = contactForm.Value\u003CIEnumerable\u003CLink\u003E\u003E(\u0022buttonLink\u0022);"
        },
