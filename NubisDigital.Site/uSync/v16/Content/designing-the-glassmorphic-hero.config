      "udi": null,
      "values": [
        {
          "alias": "quoteText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Great design systems let creativity flourish instead of slowing it down."
        },
        {
          "alias": "quoteAttribution",
