          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Glassmorphic cards lining up across About, Services, and Contact."
        }
      ]
    },
    {
      "contentTypeKey": "4b1b3cd0-97c8-4bae-b22b-da89d9b5ba8b",
      "key": "f9cb4f55-9a58-4adb-bbd1-0fda9c0f9d64",
