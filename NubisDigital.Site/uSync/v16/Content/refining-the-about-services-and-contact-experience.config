          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EEach generic page now combines hero, informational sections, and call-to-action patterns. Inline edits make it feel like writing in a design tool, and the CTAs consistently surface the most important conversions.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "7c9496d3-7122-4232-9fa2-161e50aa8cd7",
