          "segment": null,
          "value": {
            "blocks": null,
            "markup": "\u003Cul\u003E\u003Cli\u003EComposable Umbraco architectures tuned for editorial joy\u003C/li\u003E\u003Cli\u003EGlassmorphic React/Tailwind design systems\u003C/li\u003E\u003Cli\u003EBlock-driven content journeys with performance baked in\u003C/li\u003E\u003C/ul\u003E"
