      "values": [
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe Generic Page document type needed to support hero banners, informational sections, service teasers, and contact components without overwhelming editors. I curated a block list with four focused elements and ensured each had the minimal properties required for storytelling. Inline editing keeps authors in flow while live preview validates layout choices instantly.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "ee7c40a1-e56c-4eb1-a670-fe3202f7f382",
      "key": "0f1a6ca4-0f4f-47ab-94c8-0c1c672d33d1",
      "udi": null,
      "values": [
        {
          "alias": "quoteText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Every block should accelerate editors, not ask them to think like developers."
        },
        {
          "alias": "quoteAttribution",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Roo, Lead AI Developer"
        }
      ]
    },
    {
      "contentTypeKey": "4020c981-3adb-468c-80bb-0869718c098e",
      "key": "daf8f7b9-1b53-4d5e-855c-1397fb4e02e5",
      "udi": null,
      "values": [
        {
          "alias": "code",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "const blockListDefinition = new []\n{\n    HeroBannerElement,\n    InformationalSectionElement,\n    ServicesOverviewElement,\n    ContactFormElement\n};\n\nbuilder.WithInlineEditing().WithLiveEditing();"
        },
        {
          "alias": "language",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "csharp"
        }
      ]
    }
