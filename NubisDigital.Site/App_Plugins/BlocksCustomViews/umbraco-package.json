{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Nubis.BlockGridCustomViews",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.richText",
      "name": "Blog Rich Text Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/blog-richtext-view.js",
      "forContentTypeAlias": "blogRichTextBlock"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.headline",
      "name": "Blog Headline Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/blog-headline-view.js",
      "forContentTypeAlias": "blogHeadlineBlock"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.image",
      "name": "Blog Image Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/blog-image-view.js",
      "forContentTypeAlias": "blogImageBlock"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.quote",
      "name": "Blog Quote Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/blog-quote-view.js",
      "forContentTypeAlias": "blogQuoteBlock"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.code",
      "name": "Blog Code Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/blog-code-view.js",
      "forContentTypeAlias": "blogCodeBlock"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.heroBanner",
      "name": "Hero Banner Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/hero-banner-view.js",
      "forContentTypeAlias": "heroBannerElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.callToAction",
      "name": "Call To Action Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/call-to-action-view.js",
      "forContentTypeAlias": "callToActionElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.servicesOverview",
      "name": "Services Overview Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/services-overview-view.js",
      "forContentTypeAlias": "servicesOverviewElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.latestBlogPosts",
      "name": "Latest Blog Posts Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/latest-blog-posts-view.js",
      "forContentTypeAlias": "latestBlogPostsElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.informationalSection",
      "name": "Informational Section Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/informational-section-view.js",
      "forContentTypeAlias": "informationalSectionElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.contactForm",
      "name": "Contact Form Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/contact-form-view.js",
      "forContentTypeAlias": "contactFormElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.heroSlider",
      "name": "Hero Slider Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/hero-slider-view.js",
      "forContentTypeAlias": "heroSliderElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.informationalSlider",
      "name": "Informational Slider Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/informational-slider-view.js",
      "forContentTypeAlias": "informationalSliderElement"
    },
    {
      "type": "blockEditorCustomView",
      "alias": "nubis.blockEditorCustomView.quickContactForm",
      "name": "Quick Contact Form Custom View",
      "element": "/App_Plugins/BlocksCustomViews/dist/quick-contact-form-view.js",
      "forContentTypeAlias": "quickContactFormElement"
    }
  ]
}