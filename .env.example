# ── Lead capture (Resend) ────────────────────────────────────────────────
# Get a key at https://resend.com (free tier: 3k emails/mo).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where leads are delivered:
LEAD_TO_EMAIL=hello@nubis.digital
# Verified sender on your Resend domain (use onboarding@resend.dev to test):
LEAD_FROM_EMAIL=onboarding@resend.dev

# ── AI agent proxy ───────────────────────────────────────────────────────
# Provider: "anthropic" (default) or "openai".
AI_PROVIDER=anthropic
# Server-side only — NEVER exposed to the browser.
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Optional model override (defaults: anthropic=claude-haiku-4-5, openai=gpt-4o-mini)
AI_MODEL=claude-haiku-4-5
